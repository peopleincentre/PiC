---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title?: string;
  description?: string;
  /** Absolute URL or site-relative path (with or without leading slash) for the Open Graph image. */
  image?: string;
  type?: string;
  robots?: string;
  /** Extra JSON-LD objects (e.g. BreadcrumbList, Person, ScholarlyArticle) merged into one @graph block. */
  jsonLd?: Record<string, unknown>[];
  bodyClass?: string;
}

const {
  title = "People in Centre",
  description = "People in Centre Consulting Services Pvt. Ltd. is a knowledge-driven development consultancy committed to people-centred planning, recovery and development.",
  image,
  type = "website",
  robots = "index, follow",
  jsonLd = [],
  bodyClass = "",
} = Astro.props;

const site = Astro.site ?? new URL("http://localhost:4321");
const canonical = new URL(Astro.url.pathname, site).toString();

/** Resolve a logo/image path relative to the site root, honouring the base path. */
const absolute = (path: string) =>
  /^https?:\/\//.test(path)
    ? path
    : new URL(`${import.meta.env.BASE_URL}${path.replace(/^\//, "")}`, site).toString();

const siteName = "People in Centre";
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const ogImage = absolute(image ?? "images/logo-1.png");
const siteUrl = absolute("");
const orgId = `${siteUrl}#organization`;
const siteId = `${siteUrl}#website`;

const organization = {
  "@type": "Organization",
  "@id": orgId,
  name: "People in Centre",
  legalName: "People in Centre Consulting Services Pvt. Ltd.",
  url: siteUrl,
  logo: ogImage,
  email: "office@peopleincentre.org",
  telephone: "+91-8401604315",
  sameAs: [
    "https://www.linkedin.com/company/people-in-centre-consulting",
    "https://www.youtube.com/@People-in-Centre",
  ],
};

const website = {
  "@type": "WebSite",
  "@id": siteId,
  name: siteName,
  url: siteUrl,
  description,
  publisher: { "@id": orgId },
};

const graph = [organization, website, ...jsonLd];
---

<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Roboto+Slab:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#1e293b" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={siteName} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })}></script>

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <Header />

    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
