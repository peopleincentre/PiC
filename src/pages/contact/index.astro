---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

const page = (await getCollection("pages")).find((p) => p.id === "contact");
await render(page);

const {
  title,
  description,
  introLead,
  introBody,
  cards = [],
  conversation,
  details = [],
} = page.data;
---

<BaseLayout title={title} description={description}>

<div class="contact-page">

<header class="contact-intro">
  <h1>{title}</h1>
  {introLead && <p class="contact-lead"><strong>{introLead}</strong></p>}
  {introBody && <p>{introBody}</p>}
</header>

{
  cards.length > 0 && (
    <div class="contact-cards">
      {cards.map((card) => (
        <section class="contact-card">
          <h2>{card.heading}</h2>
          <p class="card-eyebrow">{card.eyebrow}</p>
          <p class="card-body">{card.body}</p>
          <a class="contact-btn" href={`mailto:${conversation?.email ?? "office@peopleincentre.org"}`}>
            {card.button}
          </a>
        </section>
      ))}
    </div>
  )
}

{
  (conversation || details.length > 0) && (
    <div class="contact-footer-row">

      {conversation && (
        <section class="contact-card">
          <h3>{conversation.title}</h3>
          <p>{conversation.intro}</p>
          <p class="contact-email">
            <a href={`mailto:${conversation.email}`}>{conversation.email}</a>
          </p>
          {
            conversation.socials && conversation.socials.length > 0 && (
              <p class="contact-socials">
                You can also connect with us on{" "}
                {conversation.socials.map((social, i) => (
                  <span key={social.label}>
                    {i > 0 && " and "}
                    <a href={social.href} target="_blank" rel="noopener noreferrer">
                      {social.label}
                    </a>
                  </span>
                ))}{" "}
                to follow our work and activities.
              </p>
            )
          }
        </section>
      )}

      {details.length > 0 && (
        <section class="contact-card">
          <h3>Direct contact details</h3>
          {details.map((detail) => (
            <div class="detail-item">
              <strong>{detail.label}</strong>
              {detail.email && (
                <a href={`mailto:${detail.email}`}>{detail.email}</a>
              )}
              {detail.phone && <span>{detail.phone}</span>}
            </div>
          ))}
        </section>
      )}

    </div>
  )
}

</div>

</BaseLayout>

<style>

.contact-page {
  max-width: 760px;
  margin: 0 auto;
  padding: 2.5rem 1.5rem 3rem;
}

.contact-intro h1 {
  margin: 0 0 1.5rem;
  font-size: clamp(1.9rem, 4vw, 2.5rem);
  line-height: 1.25;
}

.contact-intro .contact-lead {
  color: var(--color-heading);
}

.contact-intro p {
  margin: 0 0 1rem;
}

.contact-cards {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.25rem;
  margin-top: 2rem;
}

.contact-card {
  position: relative;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-top: 4px solid var(--color-urban);
  border-radius: 14px;
  padding: 1.75rem;
  box-shadow: var(--shadow-card);
}

.contact-card h2 {
  margin: 0 0 0.5rem;
  font-size: 1.35rem;
  line-height: 1.3;
}

.contact-card h3 {
  margin: 0 0 0.75rem;
  font-size: 1.15rem;
  line-height: 1.3;
}

.card-eyebrow {
  margin: 0 0 1rem;
  font-family: "Plus Jakarta Sans", sans-serif;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.card-body {
  margin: 0 0 1.25rem;
}

.card-body + .contact-btn {
  margin-top: 0;
}

.contact-card a.contact-btn {
  display: inline-block;
  padding: 0.65rem 1.5rem;
  border-radius: 999px;
  background: var(--color-urban);
  color: #fff;
  font-family: "Plus Jakarta Sans", sans-serif;
  font-weight: 600;
  text-decoration: none;
  transition: filter 0.2s ease, transform 0.2s ease;
}

.contact-card a.contact-btn:hover {
  filter: brightness(1.12);
  transform: translateY(-1px);
}

.contact-footer-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
  margin-top: 1.25rem;
}

.contact-email {
  margin: 0 0 0.75rem;
  font-size: 1.1rem;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.contact-card a {
  color: var(--color-urban);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.contact-card a:hover {
  text-decoration-thickness: 2px;
}

.detail-item {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  margin-bottom: 1rem;
}

.detail-item:last-child {
  margin-bottom: 0;
}

.detail-item strong {
  font-size: 0.95rem;
}

.detail-item a,
.detail-item span {
  overflow-wrap: anywhere;
}

@media (max-width: 700px) {
  .contact-page {
    padding: 1.5rem 1rem 2.5rem;
  }

  .contact-footer-row {
    grid-template-columns: 1fr;
  }
}

</style>