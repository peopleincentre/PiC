---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const papers = await getCollection("papers");
const videos = await getCollection("videos");

const paperThemes = [
  {
    id: "ecological-balance",
    label: "Restructuring Human Interventions for Ecological Balance",
    accent: "var(--color-ecology)",
  },
  {
    id: "resilience",
    label: "Reinforcing People's Capacities to Reduce Disaster Risks",
    accent: "var(--color-resilience)",
  },
  {
    id: "urban-space",
    label: "Reclaiming Urban Space for the People",
    accent: "var(--color-urban)",
  },
];

const videoGroups = [
  {
    id: "videos-water",
    title: "On Water and Wastewater",
    accent: "var(--color-ecology)",
    youtubeIds: [
      "yIM46clCXRw",
      "QSxx8KnOZUk",
      "ES4TaT05S-I",
      "qZUxptX1018",
      "Ny2365kjbqQ",
      "A4rK4imBcrk",
    ],
  },
  {
    id: "videos-housing",
    title: "On Post Disaster Housing Reconstruction",
    accent: "var(--color-resilience)",
    youtubeIds: ["kw-mK5uV5v8"],
  },
];

const featuredYoutubeId = "7CVk94W4dEI";

function byYearDesc(a, b) {
  return (b.data.year ?? 0) - (a.data.year ?? 0);
}

function paperLink(pdf) {
  return (pdf || "").startsWith("http") ? pdf : null;
}

function linkType(url) {
  const u = (url || "").trim().toLowerCase();
  if (!u) return null;
  return u.split("?")[0].endsWith(".pdf") ? "pdf" : "download";
}

const videoById = new Map(videos.map((v) => [v.data.youtube, v]));
const featuredVideo = videoById.get(featuredYoutubeId) ?? videos[0];

const papersCount = papers.length;
const videosCount = videos.length;

const iconDoc = `
  <svg class="tab-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path fill="currentColor" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm0 2.5L18.5 9H14V4.5zM8 13h8v2H8zm0 4h8v2H8z"/>
  </svg>`;

const iconPlay = `
  <svg class="tab-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path fill="currentColor" d="M8 5.14v13.72c0 .8.87 1.3 1.56.88l11-6.86a1.04 1.04 0 0 0 0-1.76l-11-6.86A1.03 1.03 0 0 0 8 5.14z"/>
  </svg>`;

const iconPdf = `
  <svg class="icon-btn-svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
    <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
    <path d="M12 18v-6"/>
    <path d="m9 15 3 3 3-3"/>
  </svg>`;

const iconDownload = `
  <svg class="icon-btn-svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
    <path d="m7 10 5 5 5-5"/>
    <path d="M12 15V3"/>
  </svg>`;

const iconQuote = `
  <svg class="icon-btn-svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path fill="currentColor" d="M6 17h3l2-4V7H5v6h3l-2 4zm8 0h3l2-4V7h-6v6h3l-2 4z"/>
  </svg>`;

const themeIcons = {
  "ecological-balance": `
    <svg class="group-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path fill="currentColor" d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/>
    </svg>`,
  resilience: `
    <svg class="group-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path fill="currentColor" d="M12 2l2.4 4.6L19.6 7l-3.5 3.4.9 5.1L12 13.2l-5 2.3.9-5.1L4.4 7l5.2-.4L12 2z"/>
    </svg>`,
  "urban-space": `
    <svg class="group-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path fill="currentColor" d="M10 2v6H3a1 1 0 0 0-1 1v10h2v2h2v-2h12v2h2v-2h2V9a1 1 0 0 0-1-1h-7V2h-2zM5 16h2v3H5v-3zm4 0h2v3H9v-3zm4 0h2v3h-2v-3zm4 0h2v3h-2v-3z"/>
    </svg>`,
};
---

<BaseLayout title="Knowledge Resources">

<main class="resources-page">

<header class="page-head">
  <h1>Knowledge Resources</h1>
  <p class="page-intro">
    Research papers, publications and films by People in Centre, organised by
    thematic area.
  </p>
</header>

<div
  class="tabs"
  role="tablist"
  aria-label="Knowledge resources"
  id="resources-tabs"
>
  <button
    class="tab"
    id="tab-papers"
    role="tab"
    aria-selected="true"
    aria-controls="panel-papers"
    data-target="papers"
    type="button"
  >
    <Fragment set:html={iconDoc} />
    <span class="tab-label">Research Papers &amp; Publications</span>
    <span class="tab-count">{papersCount}</span>
  </button>

  <button
    class="tab"
    id="tab-videos"
    role="tab"
    aria-selected="false"
    aria-controls="panel-videos"
    data-target="videos"
    type="button"
  >
    <Fragment set:html={iconPlay} />
    <span class="tab-label">Videos &amp; Films</span>
    <span class="tab-count">{videosCount}</span>
  </button>
</div>

<nav
  class="theme-nav"
  id="theme-nav-papers"
  aria-label="Jump to thematic area"
>
  {paperThemes.map((theme) => (
    <button
      class="theme-pill"
      type="button"
      data-target-group={`papers-${theme.id}`}
      style={`--pill-accent: ${theme.accent}`}
    >
      <span class="pill-dot" aria-hidden="true"></span>
      {theme.label}
    </button>
  ))}
</nav>

<nav
  class="theme-nav"
  id="theme-nav-videos"
  aria-label="Jump to video theme"
  hidden
>
  {videoGroups.map((group) => (
    <button
      class="theme-pill"
      type="button"
      data-target-group={group.id}
      style={`--pill-accent: ${group.accent}`}
    >
      <span class="pill-dot" aria-hidden="true"></span>
      {group.title}
    </button>
  ))}
</nav>

<section
  class="tab-panel"
  id="panel-papers"
  role="tabpanel"
  aria-labelledby="tab-papers"
  data-panel="papers"
>
  {paperThemes.map((theme) => {
    const themePapers = papers
      .filter((p) => p.data.themes.includes(theme.id))
      .sort(byYearDesc);
    if (themePapers.length === 0) return null;
    return (
      <div
        class="group"
        id={`papers-${theme.id}`}
        style={`--accent: ${theme.accent}`}
      >
        <h3>
          <Fragment set:html={themeIcons[theme.id] || ""} />
          <span class="group-title">{theme.label}</span>
          <span class="group-count">
            {themePapers.length}{" "}
            {themePapers.length === 1 ? "paper" : "papers"}
          </span>
        </h3>
        <ul class="papers-grid">
          {themePapers.map((paper) => {
            const link = paperLink(paper.data.pdf);
            const linkKind = link ? linkType(link) : null;
            return (
              <li class="paper-card">
                <span class="paper-year">{paper.data.year}</span>
                <span class="paper-citation">{paper.data.summary}</span>
                <div class="paper-actions">
                  {linkKind === "pdf" && (
                    <a
                      class="paper-icon-btn paper-pdf-link"
                      href={link}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Open PDF"
                      title="Open PDF"
                    >
                      <Fragment set:html={iconPdf} />
                    </a>
                  )}
                  {linkKind === "download" && (
                    <a
                      class="paper-icon-btn paper-download-link"
                      href={link}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Download resource"
                      title="Download resource"
                    >
                      <Fragment set:html={iconDownload} />
                    </a>
                  )}
                  <div class="cite-wrap">
                    <button
                      class="paper-icon-btn cite-btn"
                      type="button"
                      aria-label="Export citation (Zotero or BibTeX)"
                      aria-haspopup="true"
                      aria-expanded="false"
                      title="Export citation (Zotero or BibTeX)"
                      data-authors={paper.data.authors}
                      data-year={paper.data.year}
                      data-title={paper.data.title}
                      data-url={link || ""}
                      data-summary={paper.data.summary}
                    >
                      <Fragment set:html={iconQuote} />
                    </button>
                    <div class="citation-popover" role="menu" hidden>
                      <button type="button" role="menuitem" data-format="ris">
                        Zotero (.ris)
                      </button>
                      <button type="button" role="menuitem" data-format="bib">
                        BibTeX (.bib)
                      </button>
                    </div>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    );
  })}
</section>

<section
  class="tab-panel"
  id="panel-videos"
  role="tabpanel"
  aria-labelledby="tab-videos"
  data-panel="videos"
  hidden
>
  {featuredVideo && (
    <div class="featured-video">
      <div class="video-embed">
        <iframe
          src={`https://www.youtube.com/embed/${featuredVideo.data.youtube}`}
          title={featuredVideo.data.title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
      <h3>{featuredVideo.data.title}</h3>
      <p>{featuredVideo.data.summary}</p>
    </div>
  )}

  {videoGroups.map((group) => {
    const groupVideos = group.youtubeIds
      .map((id) => videoById.get(id))
      .filter(Boolean);
    if (groupVideos.length === 0) return null;
    return (
      <div
        class="group"
        id={group.id}
        style={`--accent: ${group.accent}`}
      >
        <h3>
          <Fragment set:html={iconPlay} />
          <span class="group-title">{group.title}</span>
          <span class="group-count">
            {groupVideos.length} {groupVideos.length === 1 ? "video" : "videos"}
          </span>
        </h3>
        <div class="videos-grid">
          {groupVideos.map((video) => (
            <a
              class="video-card"
              href={`https://www.youtube.com/watch?v=${video.data.youtube}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="video-thumb">
                <img
                  src={`https://img.youtube.com/vi/${video.data.youtube}/0.jpg`}
                  alt={video.data.title}
                  loading="lazy"
                />
                <span class="play" aria-hidden="true"></span>
              </div>
              <h4>{video.data.title}</h4>
              <p>{video.data.summary}</p>
              <span class="video-watch">Watch on YouTube</span>
            </a>
          ))}
        </div>
      </div>
    );
  })}
</section>

</main>

</BaseLayout>

<script>
  const tabs = Array.from(document.querySelectorAll("#resources-tabs .tab"));
  const panels = Array.from(document.querySelectorAll("[data-panel]"));

  function activate(target) {
    tabs.forEach((tab) => {
      const active = tab.dataset.target === target;
      tab.setAttribute("aria-selected", active ? "true" : "false");
      tab.tabIndex = active ? 0 : -1;
    });

    panels.forEach((panel) => {
      if (panel.dataset.panel === target) {
        panel.removeAttribute("hidden");
      } else {
        panel.setAttribute("hidden", "");
      }
    });

    toggleThemeNav(target);
    setupScrollSpy(target);

    const activeTab = tabs.find((tab) => tab.dataset.target === target);
    if (activeTab) {
      activeTab.focus();
    }
  }

  /* Theme selector nav */

  const themeNavs = {
    papers: document.querySelector("#theme-nav-papers"),
    videos: document.querySelector("#theme-nav-videos"),
  };

  const groupSets = {
    papers: Array.from(document.querySelectorAll('[id^="papers-"]')),
    videos: Array.from(document.querySelectorAll('[id^="videos-"]')),
  };

  function toggleThemeNav(target) {
    if (!themeNavs.papers || !themeNavs.videos) return;
    themeNavs.papers.hidden = target !== "papers";
    themeNavs.videos.hidden = target !== "videos";
  }

  let spyObserver = null;

  function setupScrollSpy(target) {
    if (spyObserver) spyObserver.disconnect();
    spyObserver = null;
    const nav = themeNavs[target];
    const groups = groupSets[target];
    if (!nav || !groups || groups.length === 0) return;

    const pills = Array.from(nav.querySelectorAll(".theme-pill"));
    pills.forEach((pill) => pill.classList.remove("is-active"));

    spyObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort(
            (a, b) => a.boundingClientRect.top - b.boundingClientRect.top
          );
        const current = visible[0];
        if (!current) return;
        const id = current.target.id;
        pills.forEach((pill) => {
          pill.classList.toggle(
            "is-active",
            pill.dataset.targetGroup === id
          );
        });
      },
      { rootMargin: "-15% 0px -70% 0px", threshold: 0 }
    );

    groups.forEach((group) => spyObserver.observe(group));
  }

  document.querySelectorAll(".theme-pill").forEach((pill) => {
    pill.addEventListener("click", () => {
      const target = document.getElementById(pill.dataset.targetGroup);
      if (!target) return;
      const header = document.querySelector("header");
      const nav = document.querySelector(".theme-nav:not([hidden])");
      let offset = header ? header.offsetHeight : 0;
      if (nav && getComputedStyle(nav).position === "sticky") {
        offset += nav.offsetHeight;
      }
      const top = target.getBoundingClientRect().top + window.scrollY - offset - 12;
      window.scrollTo({ top: Math.max(top, 0), behavior: "smooth" });
    });
  });

  /* Citation export popover */

  const citeBtns = Array.from(document.querySelectorAll(".cite-btn"));

  function closeAllPopovers(except) {
    citeBtns.forEach((btn) => {
      if (btn === except) return;
      btn.setAttribute("aria-expanded", "false");
      const pop = btn.parentElement.querySelector(".citation-popover");
      if (pop) pop.hidden = true;
    });
  }

  citeBtns.forEach((btn) => {
    const pop = btn.parentElement.querySelector(".citation-popover");

    btn.addEventListener("click", (event) => {
      event.stopPropagation();
      const expanded = btn.getAttribute("aria-expanded") === "true";
      closeAllPopovers(btn);
      const nowOpen = !expanded;
      btn.setAttribute("aria-expanded", nowOpen ? "true" : "false");
      if (pop) pop.hidden = !nowOpen;
    });

    if (pop) {
      pop.addEventListener("click", (event) => {
        event.stopPropagation();
        const item = event.target.closest("[data-format]");
        if (!item) return;
        exportCitation(btn, item.dataset.format);
        btn.setAttribute("aria-expanded", "false");
        pop.hidden = true;
      });
    }
  });

  document.addEventListener("click", () => closeAllPopovers(null));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeAllPopovers(null);
  });

  function splitAuthors(authors) {
    if (!authors) return [];
    return authors
      .split(/\s*(?:&|and)\s*|,\s*/i)
      .map((part) => part.replace(/^[,.\s]+|[,.\s]+$/g, "").trim())
      .filter(Boolean);
  }

  function bibKey(authors, year) {
    const first = splitAuthors(authors)[0] || "paper";
    const surname = first.split(",")[0].trim().toLowerCase();
    const clean = surname.replace(/[^a-z]/g, "") || "paper";
    return year ? `${clean}${year}` : clean;
  }

  function escapeBib(text) {
    return String(text || "")
      .replace(/\\/g, "\\\\")
      .replace(/([&%#_~])/g, "\\$1");
  }

  function downloadFile(filename, content, mime) {
    const blob = new Blob([content], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  function exportCitation(btn, format) {
    const authors = splitAuthors(btn.dataset.authors);
    const year = parseInt(btn.dataset.year, 10) || "";
    const title = btn.dataset.title || "";
    const url = btn.dataset.url || "";
    const summary = btn.dataset.summary || "";
    const key = bibKey(btn.dataset.authors, year);

    if (format === "bib") {
      const lines = [
        `@misc{${key},`,
        `  author = {${authors.join(" and ")}},`,
        `  title = {${escapeBib(title)}},`,
      ];
      if (year) lines.push(`  year = {${year}},`);
      if (url) lines.push(`  url = {${url}},`);
      lines.push(`  note = {${escapeBib(summary)}}`);
      lines.push("}");
      downloadFile(`${key}.bib`, lines.join("\n"), "application/x-bibtex");
    } else {
      const lines = ["TY  - GEN"];
      authors.forEach((a) => lines.push(`AU  - ${a}`));
      if (year) lines.push(`PY  - ${year}`);
      lines.push(`TI  - ${title}`);
      if (url) lines.push(`UR  - ${url}`);
      if (summary) lines.push(`AB  - ${summary}`);
      lines.push("ER  - ");
      downloadFile(
        `${key}.ris`,
        lines.join("\n"),
        "application/x-research-info-systems"
      );
    }
  }

  function tabFromHash() {
    const hash = window.location.hash.replace("#", "");
    return hash === "videos" ? "videos" : "papers";
  }

  function setHash(target, update = true) {
    if (update && window.location.hash !== `#${target}`) {
      history.replaceState(null, "", `#${target}`);
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.dataset.target;
      setHash(target);
      activate(target);
    });

    tab.addEventListener("keydown", (event) => {
      const current = tabs.indexOf(tab);
      let next = null;

      if (event.key === "ArrowRight") next = tabs[(current + 1) % tabs.length];
      if (event.key === "ArrowLeft")
        next = tabs[(current - 1 + tabs.length) % tabs.length];
      if (event.key === "Home") next = tabs[0];
      if (event.key === "End") next = tabs[tabs.length - 1];

      if (next) {
        event.preventDefault();
        next.click();
      }
    });
  });

  window.addEventListener("hashchange", () => {
    activate(tabFromHash());
  });

  activate(tabFromHash());
</script>

<style>

.resources-page {
  max-width: 1100px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
}

.page-head h1 {
  margin: 0 0 0.5rem;
  line-height: 2.5rem;
}

.page-intro {
  max-width: 700px;
  color: #666;
  line-height: 1.6;
  margin: 0 0 1.75rem;
}

/* Tabs */

.tabs {
  display: inline-flex;
  gap: 0.5rem;
  background: #e8ecee;
  padding: 0.375rem;
  border-radius: 999px;
  margin-bottom: 0;
  flex-wrap: wrap;
}

.tab {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  border: none;
  background: transparent;
  padding: 0.6rem 1.15rem;
  border-radius: 999px;
  font-family: "Inter", sans-serif;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--color-heading);
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
}

.tab:hover {
  background: rgba(35, 64, 74, 0.08);
}

.tab[aria-selected="true"] {
  background: var(--color-heading);
  color: #fff;
  box-shadow: 0 4px 14px rgba(35, 64, 74, 0.3);
}

.tab:focus-visible {
  outline: 2px solid var(--color-urban);
  outline-offset: 2px;
}

.tab-icon {
  display: block;
}

.tab-count {
  background: rgba(35, 64, 74, 0.12);
  color: var(--color-heading);
  font-size: 0.78rem;
  font-weight: 700;
  padding: 0.15rem 0.55rem;
  border-radius: 999px;
}

.tab[aria-selected="true"] .tab-count {
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
}

/* Theme selector nav */

.theme-nav[hidden] {
  display: none;
}

.theme-nav {
  position: sticky;
  top: 74px;
  z-index: 20;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  padding: 0.7rem 0 0.85rem;
  margin-bottom: 2rem;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(6px);
  border-bottom: 1px solid var(--color-border);
}

.theme-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  border: 1px solid var(--color-border);
  background: #fff;
  border-radius: 999px;
  padding: 0.45rem 1rem;
  font-family: "Inter", sans-serif;
  font-size: 0.85rem;
  font-weight: 600;
  line-height: 1.3;
  color: var(--color-heading);
  cursor: pointer;
  transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease,
    box-shadow 0.2s ease;
}

.theme-pill:hover {
  border-color: var(--pill-accent);
  color: var(--pill-accent);
}

.theme-pill.is-active {
  background: var(--pill-accent);
  border-color: var(--pill-accent);
  color: #fff;
  box-shadow: 0 4px 12px color-mix(in srgb, var(--pill-accent) 35%, transparent);
}

.pill-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--pill-accent);
  flex-shrink: 0;
}

.theme-pill.is-active .pill-dot {
  background: #fff;
}

/* Panels */

.tab-panel[hidden] {
  display: none;
}

/* Groups */

.group {
  margin-bottom: 2.25rem;
  background: color-mix(in srgb, var(--accent) 6%, #fff);
  border: 1px solid color-mix(in srgb, var(--accent) 22%, #fff);
  border-radius: 14px;
  padding: 1.5rem;
}

.group > h3 {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin: 0 0 1.25rem;
  padding: 0 0 0.75rem;
  border-bottom: 2px solid color-mix(in srgb, var(--accent) 25%, #fff);
