---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = await getCollection("projects");

const themeProjects = projects
  .filter((project) =>
    project.data.themes.includes("ecological-balance")
  )
  .sort(
    (a, b) =>
      (b.data.endYear ?? b.data.startYear ?? 0) -
      (a.data.endYear ?? a.data.startYear ?? 0)
  );
---

<BaseLayout title="Restructuring Human Interventions for Ecological Balance" bodyClass="work-theme-page">

<h1>
  Restructuring Human Interventions for Ecological Balance
</h1>

<h2>
  Projects
</h2>

<div class="project-grid">
  {
    themeProjects.map((project) => (
      <ProjectCard project={project} />
    ))
  }
</div>

</BaseLayout>

<style>

.project-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-top: 2rem;
}

@media (max-width: 1100px) {
  .project-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .project-grid {
    grid-template-columns: 1fr;
  }
}

</style>
