---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Our Work">

<h1>
  Our Work
</h1>

<p>
  People in Centre works across four thematic areas that
  seek to strengthen resilience, restore ecological balance,
  reclaim urban space for people, and build institutional
  capacities for learning and action.
</p>

<div class="themes">

  <a class="theme-card" href={`${base}work/resilience/`}>
    <h2>Reinforcing People's Resilience to Disasters</h2>
    <p>
      Supporting communities, governments and institutions in
      disaster recovery, resilient housing, risk reduction and
      reconstruction through people-centred approaches.
    </p>
  </a>

  <a class="theme-card" href={`${base}work/ecological-balance/`}>
    <h2>Restructuring Human Interventions for Ecological Balance</h2>
    <p>
      Working on water, sanitation, wastewater reuse,
      environmental restoration and sustainable resource
      management.
    </p>
  </a>

  <a class="theme-card" href={`${base}work/urban-space/`}>
    <h2>Reclaiming Urban Space for the People</h2>
    <p>
      Addressing housing, settlements, public spaces and urban
      services with a focus on equity and inclusion.
    </p>
  </a>

  <a class="theme-card" href={`${base}work/institutional-initiatives/`}>
    <h2>Other Institutional Initiatives</h2>
    <p>
      Advanced Certificate Programme on Research in Political
      Economy, fellowships and capacity-building initiatives.
    </p>
  </a>

</div>

</BaseLayout>

<style>

.themes {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
  margin-top: 2rem;
}

.theme-card {
  display: block;
  padding: 2rem;
  border: 1px solid #ddd;
  border-radius: 8px;
  text-decoration: none;
  color: inherit;
  background: #fff;
  transition: transform 0.2s ease;
}

.theme-card:hover {
  transform: translateY(-4px);
}

.theme-card h2 {
  margin-top: 0;
  margin-bottom: 1rem;
}

.theme-card p {
  margin-bottom: 0;
  line-height: 1.6;
}

</style>
