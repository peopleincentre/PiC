---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = await getCollection("projects");

const themeProjects = projects
  .filter((project) =>
    project.data.themes.includes("institutional-initiatives")
  )
  .sort(
    (a, b) =>
      (b.data.endYear ?? b.data.startYear ?? 0) -
      (a.data.endYear ?? a.data.startYear ?? 0)
  );
---

<BaseLayout title="Reconnecting Research with the Socio-Economic Realities of Communities">

<h1>
  Reconnecting Research with the Socio-Economic Realities of Communities
</h1>

<p class="theme-intro">
  Traditional academic curricula often fall short of equipping young researchers
  and practitioners with the socio-economic, field-based realities of
  development, economics, technology and governance. We facilitate alternative
  educational programmes, certificate courses and practical research platforms
  that take learning beyond college classrooms. By mentoring students and
  emerging scholars in field-anchored socio-economic research, we nurture a new
  generation of researchers capable of tackling real-world social and
  developmental challenges. Our partners include International Development
  Economics Associates (IDEAs).
</p>

<h2>
  Initiatives
</h2>

<div class="project-grid">
  {
    themeProjects.map((project) => (
      <ProjectCard project={project} />
    ))
  }
</div>

</BaseLayout>

<style>

.theme-intro {
  max-width: 900px;
  line-height: 1.7;
  margin-bottom: 2rem;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
  margin-top: 2rem;
}

@media (max-width: 1100px) {
  .project-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .project-grid {
    grid-template-columns: 1fr;
  }
}

</style>
