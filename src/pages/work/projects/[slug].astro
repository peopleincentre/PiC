---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: {
      slug: project.id,
    },
    props: {
      project,
    },
  }));
}

const { project } = Astro.props;

const {
  title,
  summary,
  description,
  country,
  location,
  startYear,
  endYear,
  client,
  partners,
  coverImage,
  gallery,
  themes,
} = project.data;

const base = import.meta.env.BASE_URL;
const siteUrl = new URL(base, Astro.site).toString();

const { Content } = await render(project);

const themeLabels = {
  "ecological-balance": "Ecological Balance",
  resilience: "Resilience to Disasters",
  "urban-space": "Urban Space",
  "institutional-initiatives": "Institutional Initiatives",
};
const themeId = themes?.[0];
const themeLabel = themeId ? (themeLabels[themeId] ?? "Projects") : null;

const byRecency = (list) =>
  [...list].sort(
    (a, b) =>
      (b.data.endYear ?? b.data.startYear ?? 0) -
      (a.data.endYear ?? a.data.startYear ?? 0)
  );

const allProjects = await getCollection("projects");
const relatedProjects = themeId
  ? byRecency(
      allProjects.filter(
        (p) =>
          p.id !== project.id && (p.data.themes || []).includes(themeId)
      )
    ).slice(0, 3)
  : [];

const breadcrumbItems = [
  { position: 1, name: "Home", item: siteUrl },
  { position: 2, name: "Our Work", item: `${siteUrl}work/` },
  ...(themeId && themeLabel
    ? [
        {
          position: 3,
          name: themeLabel,
          item: `${siteUrl}work/${themeId}/`,
        },
        {
          position: 4,
          name: title,
          item: `${siteUrl}work/projects/${project.id}/`,
        },
      ]
    : [{ position: 3, name: title, item: `${siteUrl}work/projects/${project.id}/` }]),
];

const breadcrumbJsonLd = {
  "@type": "BreadcrumbList",
  "@id": `${siteUrl}work/projects/${project.id}/#breadcrumb`,
  itemListElement: breadcrumbItems,
};
---

<BaseLayout
  title={title}
  description={description || summary}
  image={coverImage}
  type="article"
  jsonLd={[breadcrumbJsonLd]}
>

  <div class="project-page">

    {themeId && (
      <a
        class="back-link"
        href={`${base}work/${themeId}/`}
        aria-label={`Back to ${themeLabels[themeId] ?? "Projects"}`}
        title={`Back to ${themeLabels[themeId] ?? "Projects"}`}
      >
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
      </a>
    )}

    {coverImage && (
      <img
        src={`${base}${coverImage.replace(/^\//, "")}`}
        alt=""
        class="hero-image"
        fetchpriority="high"
        decoding="async"
      />
    )}

    <h1>{title}</h1>

    <p class="summary">
      {summary}
    </p>

	<div class="project-meta">

		{country && (
			<div>
				<strong>Country</strong>
				<span>{country}</span>
			</div>
		)}

	{location && (
    <div>
      <strong>Location</strong>
      <span>{location}</span>
    </div>
  )}

  {(startYear || endYear) && (
    <div>
      <strong>Period</strong>
      <span>
        {startYear && endYear
          ? `${startYear}–${endYear}`
          : endYear || startYear}
      </span>
    </div>
  )}



  {partners && (
    <div>
      <strong>Collaboration</strong>
      <span>
        {Array.isArray(partners)
          ? partners.join(", ")
          : partners}
      </span>
    </div>
  )}

</div>


    <article class="content">
      <Content />
    </article>

{gallery && gallery.length > 0 && (

  <section class="gallery">

    <h2>Gallery</h2>

    <div class="gallery-grid">

      {
        gallery.map((item) => (

          <div class="gallery-item">

            <img
              src={`${base}${item.image.replace(/^\//, "")}`}
              alt={item.caption || ""}
              class="gallery-image"
              loading="lazy"
              decoding="async"
            />

            {item.caption && (
              <p class="gallery-caption">
                {item.caption}
              </p>
            )}

          </div>

        ))
      }

    </div>

  </section>

)}

{relatedProjects.length > 0 && themeId && themeLabel && (

  <section class="related-projects">

    <h2>More Projects in {themeLabel}</h2>

    <div class="related-grid">

      {relatedProjects.map((related) => (
        <a
          href={`${base}work/projects/${related.id}/`}
          class="related-card"
        >
          {related.data.coverImage && (
            <img
              src={`${base}${related.data.coverImage.replace(/^\//, "")}`}
              alt=""
              loading="lazy"
              decoding="async"
            />
          )}
          <h3>{related.data.title}</h3>
          <p>{related.data.summary}</p>
        </a>
      ))}

    </div>

    <a href={`${base}work/${themeId}/`} class="related-all">
      View all projects in {themeLabel} →
    </a>

  </section>

)}

  </div>

</BaseLayout>

<script>
  function setOrientation(img) {
    const { naturalWidth, naturalHeight } = img;
    if (!naturalWidth || !naturalHeight) return;
    const cls = naturalWidth >= naturalHeight ? "is-landscape" : "is-portrait";
    img.classList.add(cls);
  }

  document.querySelectorAll(".hero-image").forEach((img) => {
    if (img.complete) {
      setOrientation(img);
    } else {
      img.addEventListener("load", () => setOrientation(img));
    }
  });
</script>

<style>

.project-page {
  max-width: 1000px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
}


.hero-image {
  display: block;
  margin: 0 auto 1rem auto;
  max-width: 100%;
  height: auto;
  border-radius: 8px;
}

.hero-image.is-landscape {
  width: 100%;
}

.hero-image.is-portrait {
  width: auto;
  max-width: 80%;
  max-height: 75vh;
}


.back-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid var(--color-border);
  background: #fff;
  color: var(--color-muted);
  margin-bottom: 1rem;
  transition: color 0.2s ease, border-color 0.2s ease;
}

.back-link:hover {
  color: var(--color-accent);
  border-color: var(--color-accent);
}

h1 {
  margin-bottom: 0.25rem;
  line-height: 2.5rem
}


.summary {
  font-size: 1.15rem;
  line-height: 1.5;
  margin-bottom: 1rem;
}

.project-meta {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 0.5rem 0.25rem;
  margin: 1rem 0 1rem;
  padding: 0 0;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.project-meta div {
  display: flex;
  flex-direction: column;
}

.project-meta strong {
  font-size: 0.9rem;
  color: var(--color-muted);
  margin-bottom: 0.25rem;
}

.project-meta span {
  font-size: 1rem;
}

@media (max-width: 600px) {
  .project-meta {
    grid-template-columns: 1fr;
  }
}

.content {
  line-height: 1.5;
  font-size: 1.0rem;
  overflow-wrap: break-word;
}


.content h2 {
  margin-top: 2.5rem;
}


.gallery {
  margin-top: 2rem;
}

.related-projects {
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 1px solid var(--color-border);
}

.related-projects h2 {
  margin-bottom: 1.25rem;
}

.related-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}

.related-card {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: 12px;
  padding: 1rem;
  text-decoration: none;
  color: inherit;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.related-card:hover {
  border-color: var(--color-accent);
  transform: translateY(-2px);
}

.related-card img {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  border-radius: 8px;
  display: block;
}

.related-card h3 {
  margin: 0;
  font-size: 1rem;
  line-height: 1.3;
}

.related-card p {
  margin: 0;
  font-size: 0.9rem;
  color: var(--color-muted);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.related-all {
  display: inline-block;
  margin-top: 1.25rem;
  font-weight: 600;
  color: var(--color-urban);
  text-decoration: none;
}

.related-all:hover {
  text-decoration: underline;
}

@media (max-width: 800px) {
  .related-grid {
    grid-template-columns: 1fr;
  }
}


.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
}


.gallery-grid img {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  border-radius: 6px;
}


@media (max-width: 600px) {
  .project-page {
    padding: 1.5rem 1rem;
  }

}

</style>
