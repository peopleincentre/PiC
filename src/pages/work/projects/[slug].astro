---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: {
      slug: project.id,
    },
    props: {
      project,
    },
  }));
}

const { project } = Astro.props;

const {
  title,
  summary,
  description,
  country,
  location,
  startYear,
  endYear,
  client,
  partners,
  coverImage,
  gallery,
  themes,
} = project.data;

const base = import.meta.env.BASE_URL;

const { Content } = await render(project);

const themeLabels = {
  "ecological-balance": "Ecological Balance",
  resilience: "Resilience to Disasters",
  "urban-space": "Urban Space",
  "institutional-initiatives": "Institutional Initiatives",
};
const themeId = themes?.[0];

---

<BaseLayout title={title}>

  <main class="project-page">

    {themeId && (
      <a
        class="back-link"
        href={`${base}work/${themeId}/`}
        aria-label={`Back to ${themeLabels[themeId] ?? "Projects"}`}
        title={`Back to ${themeLabels[themeId] ?? "Projects"}`}
      >
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
      </a>
    )}

    {coverImage && (
      <img
        src={`${base}${coverImage.replace(/^\//, "")}`}
        alt={title}
        class="hero-image"
      />
    )}

    <h1>{title}</h1>

    <p class="summary">
      {summary}
    </p>

	<div class="project-meta">

		{country && (
			<div>
				<strong>Country</strong>
				<span>{country}</span>
			</div>
		)}

	{location && (
    <div>
      <strong>Location</strong>
      <span>{location}</span>
    </div>
  )}

  {(startYear || endYear) && (
    <div>
      <strong>Period</strong>
      <span>
        {startYear && endYear
          ? `${startYear}–${endYear}`
          : endYear || startYear}
      </span>
    </div>
  )}



  {partners && (
    <div>
      <strong>Collaboration</strong>
      <span>
        {Array.isArray(partners)
          ? partners.join(", ")
          : partners}
      </span>
    </div>
  )}

</div>


    <article class="content">
      <Content />
    </article>

{gallery && gallery.length > 0 && (

  <section class="gallery">

    <h2>Gallery</h2>

    <div class="gallery-grid">

      {
        gallery.map((item) => (

          <div class="gallery-item">

            <img
              src={`${base}${item.image.replace(/^\//, "")}`}
              alt={item.caption || title}
              class="gallery-image"
            />

            {item.caption && (
              <p class="gallery-caption">
                {item.caption}
              </p>
            )}

          </div>

        ))
      }

    </div>

  </section>

)}
  
  </main>

</BaseLayout>

<script>
  function setOrientation(img) {
    const { naturalWidth, naturalHeight } = img;
    if (!naturalWidth || !naturalHeight) return;
    const cls = naturalWidth >= naturalHeight ? "is-landscape" : "is-portrait";
    img.classList.add(cls);
  }

  document.querySelectorAll(".hero-image").forEach((img) => {
    if (img.complete) {
      setOrientation(img);
    } else {
      img.addEventListener("load", () => setOrientation(img));
    }
  });
</script>

<style>

.project-page {
  max-width: 1000px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
}


.hero-image {
  display: block;
  margin: 0 auto 1rem auto;
  max-width: 100%;
  height: auto;
  border-radius: 8px;
}

.hero-image.is-landscape {
  width: 100%;
}

.hero-image.is-portrait {
  width: auto;
  max-width: 80%;
  max-height: 75vh;
}


.back-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid var(--color-border);
  background: #fff;
  color: var(--color-muted);
  margin-bottom: 1rem;
  transition: color 0.2s ease, border-color 0.2s ease;
}

.back-link:hover {
  color: var(--color-accent);
  border-color: var(--color-accent);
}

h1 {
  margin-bottom: 0.25rem;
  line-height: 2.5rem
}


.summary {
  font-size: 1.15rem;
  line-height: 1.5;
  margin-bottom: 1rem;
}

.project-meta {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 0.5rem 0.25rem;
  margin: 1rem 0 1rem;
  padding: 0 0;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.project-meta div {
  display: flex;
  flex-direction: column;
}

.project-meta strong {
  font-size: 0.9rem;
  color: var(--color-muted);
  margin-bottom: 0.25rem;
}

.project-meta span {
  font-size: 1rem;
}

@media (max-width: 600px) {
  .project-meta {
    grid-template-columns: 1fr;
  }
}

.content {
  line-height: 1.5;
  font-size: 1.0rem;
}


.content h2 {
  margin-top: 2.5rem;
}


.gallery {
  margin-top: 2rem;
}


.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
}


.gallery-grid img {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  border-radius: 6px;
}


@media (max-width: 600px) {
  .project-page {
    padding: 1.5rem 1rem;
  }

}

</style>
