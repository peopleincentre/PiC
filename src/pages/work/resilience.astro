---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = await getCollection("projects");

const resilienceProjects = projects
  .filter((project) =>
    project.data.themes.includes("resilience")
  )
  .sort(
    (a, b) =>
      (b.data.endYear ?? b.data.startYear ?? 0) -
      (a.data.endYear ?? a.data.startYear ?? 0)
  );
---

<BaseLayout
  title="Reinforcing People's Resilience to Disasters"
  description="Projects on disaster risk reduction, post-disaster needs assessment, recovery and reconstruction, and resilient housing across India and beyond."
  bodyClass="work-theme-page"
>

<h1>
  Reinforcing People's Resilience to Disasters
</h1>

<h2>
  Projects
</h2>

<div class="project-grid">
  {
    resilienceProjects.map((project) => (
      <ProjectCard project={project} />
    ))
  }
</div>

</BaseLayout>

<style>

.project-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-top: 2rem;
}

@media (max-width: 1100px) {
  .project-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .project-grid {
    grid-template-columns: 1fr;
  }
}

</style>


