---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("updates", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, date, author, summary, category, cover, gallery, themes } =
  post.data;

const base = import.meta.env.BASE_URL;
const siteUrl = new URL(base, Astro.site).toString();

const { Content } = await render(post);

const themeLabels = {
  "ecological-balance": "Ecological Balance",
  resilience: "Resilience to Disasters",
  "urban-space": "Urban Space",
  "institutional-initiatives": "Institutional Initiatives",
};

const categoryLabels = {
  "work-update": "Work update",
  event: "Event",
  reflection: "Reflection",
};

const formatDate = (d) =>
  d.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: summary,
  datePublished: date.toISOString(),
  ...(author ? { author: { "@type": "Person", name: author } } : {}),
  ...(cover ? { image: cover.src } : {}),
  publisher: { "@id": `${siteUrl}#organization` },
};
---

<BaseLayout
  title={title}
  description={summary}
  image={cover?.src}
  type="article"
  jsonLd={[jsonLd]}
>
  <article class="update-article">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`${base}updates/`}>Updates</a>
      <span aria-hidden="true">/</span>
    </nav>

    <header class="update-head">
      <p class="update-meta">
        <span class="update-category">
          {categoryLabels[category] ?? "Update"}
        </span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {author && <span> · By {author}</span>}
      </p>
      <h1>{title}</h1>
      {themes && themes.length > 0 && (
        <p class="update-themes">
          {themes.map((t) => themeLabels[t] ?? t).join(" · ")}
        </p>
      )}
    </header>

    {
      cover && (
        <div class="update-cover">
          <Image
            src={cover}
            alt=""
            width={1100}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )
    }

    <p class="update-lede">{summary}</p>

    <div class="content">
      <Content />
    </div>

    {
      gallery && gallery.length > 0 && (
        <section class="update-gallery" aria-label="Photos">
          <h2>Photos</h2>
          <div class="gallery-grid">
            {gallery.map((item) => (
              <figure>
                <Image
                  src={item.image}
                  alt={item.caption || ""}
                  widths={[400, 800]}
                  sizes="(min-width: 700px) 45vw, 90vw"
                  loading="lazy"
                  decoding="async"
                />
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .update-article {
    max-width: 780px;
    margin: 0 auto;
    padding: 2rem 0 3rem;
  }

  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .breadcrumb a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .breadcrumb span {
    color: var(--color-muted);
  }

  .update-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.75rem;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .update-category {
    display: inline-block;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-weight: 700;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .update-head h1 {
    margin-bottom: 0.5rem;
    line-height: 1.25;
  }

  .update-themes {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .update-cover {
    margin: 0 0 1.75rem;
  }

  .update-cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }

  .update-lede {
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--color-heading);
    font-weight: 500;
    margin: 0 0 1.5rem;
  }

  .content {
    line-height: 1.65;
    font-size: 1rem;
    overflow-wrap: break-word;
  }

  .content :global(h2) {
    margin-top: 2.5rem;
  }

  .content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }

  .update-gallery {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .update-gallery h2 {
    margin-bottom: 1.25rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }

  .gallery-grid figure {
    margin: 0;
  }

  .gallery-grid :global(img) {
    display: block;
    width: 100%;
    height: auto; /* neutralize the height attr so aspect-ratio applies */
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  .gallery-grid figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-muted);
    line-height: 1.4;
  }
</style>
