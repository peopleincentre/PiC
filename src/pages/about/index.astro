---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const iconTools = `
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
  </svg>`;

const iconFacilitation = `
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
    <circle cx="9" cy="7" r="4"/>
    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
  </svg>`;

const iconResearch = `
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
    <circle cx="11" cy="11" r="8"/>
    <path d="m21 21-4.3-4.3"/>
  </svg>`;

const iconTraining = `
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
    <path d="M22 10v6"/>
    <path d="M2 10l10-5 10 5-10 5z"/>
    <path d="M6 12v5c3 3 9 3 12 0v-5"/>
  </svg>`;

const iconPolicy = `
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
    <path d="M14 2v6h6"/>
    <path d="M16 13H8"/>
    <path d="M16 17H8"/>
  </svg>`;

const services = [
  {
    title: "Technical assistance and advisory services",
    color: "var(--color-resilience)",
    icon: iconTools,
  },
  {
    title: "Socio-technical facilitation",
    color: "var(--color-ecology)",
    icon: iconFacilitation,
  },
  {
    title: "Research and knowledge generation",
    color: "var(--color-urban)",
    icon: iconResearch,
  },
  {
    title: "Capacity building and training",
    color: "var(--color-capacity)",
    icon: iconTraining,
  },
  {
    title: "Policy and programme development",
    color: "var(--color-resilience)",
    icon: iconPolicy,
  },
];
---

<BaseLayout title="About Us">

<main class="about-page">

<header class="about-hero">
  <h1>About People in Centre</h1>
  <p class="about-hero-sub">
    A knowledge-driven development consultancy committed to
    people-centred planning, recovery, and development.
  </p>
</header>

<section class="about-intro">
  <p>
    People in Centre Consulting Services Private Limited (PiC) is a
    knowledge-driven development consultancy registered as a private
    limited company under the Registrar of Companies, Ahmedabad
    (CIN: U74140GJ2008PTC055307). PiC continues
    to have active status with the Registrar of Companies since incorporation
    and ensures Annual General Meetings (AGMs) and statutory filings like
    financial statements and annual returns. PiC has strong founder-led
    governance with transparent ownership and stable leadership.
  </p>
  <p>
    PiC's work is rooted in a people-centred
    approach, emphasizing participation of communities in planning,
    recovery, and development processes.  PiC's board reflects a blend of
    expertise in social housing, post-disaster recovery, environmental
    planning, urban development and community processes. PiC's credibility
    comes primarily from its specialist expertise, its sustained engagement
    with international development agencies, and the professional standing
    of its leadership   deriving value from deep subject-matter expertise
    and field experience. PiC also supports the professional growth of its
    team members through mentorship and opportunities to learn through
    engagement in its work alongside experienced professionals.
  </p>
</section>

<section class="about-services">
  <h2>What We Do</h2>

  <ul class="services-list">

    {services.map((service) => (
      <li class="service-item" style={`--sc: ${service.color}`}>
        <span class="service-icon" set:html={service.icon} />
        <span>{service.title}</span>
      </li>
    ))}

  </ul>
</section>

<div class="about-nav">

<a class="about-link" href={`${base}about/team/`}>
  <strong>Team</strong>
  <span>Meet the core and past team behind People in Centre.</span>
  <span class="link-arrow" aria-hidden="true">→</span>
</a>

<a class="about-link" href={`${base}about/directors-shareholders/`}>
  <strong>Directors &amp; Shareholders</strong>
  <span>Information on the governance structure of the organisation.</span>
  <span class="link-arrow" aria-hidden="true">→</span>
</a>

<a class="about-link" href={`${base}about/annual-reports/`}>
  <strong>Annual Reports</strong>
  <span>Year-wise annual reports of People in Centre.</span>
  <span class="link-arrow" aria-hidden="true">→</span>
</a>

</div>

</main>

</BaseLayout>

<style>

.about-page {
  max-width: 960px;
  margin: 0 auto;
  padding: 3rem 1.5rem;
}

.about-hero {
  margin-bottom: 2.5rem;
  padding-bottom: 1.75rem;
  border-bottom: 1px solid var(--color-border);
}

.about-hero::before {
  content: "";
  display: block;
  width: 56px;
  height: 4px;
  border-radius: 2px;
  background: var(--color-heading);
  margin-bottom: 1rem;
}

.about-hero h1 {
  margin: 0 0 0.75rem;
  font-size: clamp(1.9rem, 4vw, 2.5rem);
  line-height: 1.25;
}

.about-hero-sub {
  margin: 0;
  max-width: 60ch;
  font-size: 1.05rem;
  color: var(--color-muted);
}

.about-intro p {
  margin-bottom: 1.25rem;
}

.about-services {
  margin-top: 3rem;
}

.about-services h2 {
  margin: 0 0 1.5rem;
  font-size: 1.5rem;
}

.services-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.75rem 2rem;
  list-style: none;
  padding: 0;
  margin: 0;
}

.service-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 0.95rem;
  line-height: 1.5;
}

.service-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--sc);
}

.about-nav {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.5rem;
  margin-top: 3rem;
}

.about-link {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 14px;
  padding: 1.5rem 2.75rem 1.5rem 1.5rem;
  text-decoration: none;
  color: inherit;
  box-shadow: 0 4px 16px rgba(30, 43, 51, 0.06);
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.about-link strong {
  font-family: "Roboto Slab", serif;
  color: var(--color-heading);
  font-size: 1.1rem;
}

.about-link span {
  font-size: 0.95rem;
  color: var(--color-text);
}

.about-link .link-arrow {
  position: absolute;
  top: 1.5rem;
  right: 1.25rem;
  font-size: 1.25rem;
  color: var(--color-heading);
  transition: transform 0.25s ease;
}

.about-link:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px rgba(30, 43, 51, 0.12);
  border-color: var(--color-heading);
}

.about-link:hover .link-arrow {
  transform: translateX(4px);
}

@media (max-width: 600px) {
  .about-page {
    padding: 1.5rem 1rem;
  }

  .services-list {
    grid-template-columns: 1fr;
  }
}

</style>
