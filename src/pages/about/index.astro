---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const iconTools = `
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
  </svg>`;

const iconFacilitation = `
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
    <circle cx="9" cy="7" r="4"/>
    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
  </svg>`;

const iconResearch = `
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
    <circle cx="11" cy="11" r="8"/>
    <path d="m21 21-4.3-4.3"/>
  </svg>`;

const iconTraining = `
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
    <path d="M22 10v6"/>
    <path d="M2 10l10-5 10 5-10 5z"/>
    <path d="M6 12v5c3 3 9 3 12 0v-5"/>
  </svg>`;

const iconPolicy = `
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
    <path d="M14 2v6h6"/>
    <path d="M16 13H8"/>
    <path d="M16 17H8"/>
  </svg>`;

const services = [
  {
    title: "Technical assistance and advisory services",
    color: "var(--color-resilience)",
    icon: iconTools,
  },
  {
    title: "Socio-technical facilitation",
    color: "var(--color-ecology)",
    icon: iconFacilitation,
  },
  {
    title: "Research and knowledge generation",
    color: "var(--color-urban)",
    icon: iconResearch,
  },
  {
    title: "Capacity building and training",
    color: "var(--color-capacity)",
    icon: iconTraining,
  },
  {
    title: "Policy and programme development",
    color: "var(--color-resilience)",
    icon: iconPolicy,
  },
];
---

<BaseLayout
  title="About Us"
  description="People in Centre Consulting Services Pvt. Ltd. (PiC) is a knowledge-driven development consultancy registered in Ahmedabad, working with communities on people-centred planning, recovery and development."
>
<div class="about-page">

<section class="about-intro">
  <div class="intro-grid">

    <div class="intro-story">
      <h2>Who We Are</h2>
      <p>
        People in Centre Consulting Services Private Limited (PiC) is a
        knowledge-driven development consultancy grounded in a people-centred
        approach to development. We work at the intersection of research, policy
        and practice, with a particular concern for poor and vulnerable communities.
        Our work is shaped by the understanding that people are not merely
        beneficiaries of development, but should be at the centre of processes
        that affect their lives. This perspective informs our work across housing,
        post-disaster recovery, environmental planning, urban development and
        community processes. Our practice draws on subject-matter expertise,
        extensive field experience and long-standing engagement with governments,
        international development agencies, practitioners and researchers.
        We also place importance on nurturing young professionals through
        mentorship and opportunities to learn through engagement with real-
        world practice.
      </p>
      <p>
        People in Centre Consulting Services Private Limited (PiC) has been 
        active since its incorporation. PiC maintains statutory compliance,
        including timely filing of financial statements and annual returns. The
        organisation has founder-led governance, stable leadership and transparent
        ownership. Its Board brings together expertise in social housing, post-disaster
        recovery, environmental planning, urban development and community processes.
        PiC's professional standing is built on the expertise and experience of
        its leadership and team, its field-based practice, peer network and long-standing
        partnerships with international development agencies.
      </p>
    </div>

    <aside class="intro-facts">
      <h3>Key Information</h3>
      <ul class="facts-list">
        <li>
          <span class="fact-label">Established</span>
          <span class="fact-value"> Year 2008, Companies Act 2013, Registrar of Companies, Ahmedabad</span>
        </li>
        <li>
          <span class="fact-label">CIN</span>
          <span class="fact-value">U74140GJ2008PTC055307</span>
        </li>
        <li>
          <span class="fact-label">PAN</span>
          <span class="fact-value">AAECP8566F</span>
        </li>
        <li>
          <span class="fact-label">GST</span>
          <span class="fact-value">24AAECP8566F1Z8</span>
        </li>
      </ul>
    </aside>

  </div>
</section>

<section class="about-services">
  <h2>What We Do</h2>

  <ul class="services-list">

    {services.map((service) => (
      <li class="service-item" style={`--sc: ${service.color}`}>
        <span class="service-icon" set:html={service.icon} />
        <span>{service.title}</span>
      </li>
    ))}

  </ul>
</section>

<div class="about-nav">

<a class="about-link" href={`${base}about/team/`}>
  <strong>Team</strong>
  <span>Meet the core and past team behind People in Centre.</span>
  <span class="link-arrow" aria-hidden="true">→</span>
</a>

<a class="about-link" href={`${base}about/directors-shareholders/`}>
  <strong>Directors &amp; Shareholders</strong>
  <span>Information on the governance structure of the organisation.</span>
  <span class="link-arrow" aria-hidden="true">→</span>
</a>

<a class="about-link" href={`${base}about/annual-reports/`}>
  <strong>Annual Reports</strong>
  <span>Year-wise annual reports of People in Centre.</span>
  <span class="link-arrow" aria-hidden="true">→</span>
</a>

</div>

</div>

</BaseLayout>

<style>

.about-page {
  max-width: 1100px;
  margin: 0 auto;
  padding: 3rem 1.5rem;
}

.intro-grid {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
  gap: 3rem;
  align-items: start;
}

.intro-story p {
  margin-bottom: 1.25rem;
}

.intro-facts {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-top: 4px solid var(--color-urban);
  border-radius: 14px;
  padding: 1.75rem;
  box-shadow: var(--shadow-card);
}

.intro-facts h3 {
  margin: 0 0 1rem;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-urban);
}

.facts-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 1.25rem;
}

.facts-list li {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding-left: 1rem;
  border-left: 2px solid var(--color-border);
}

.fact-label {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-muted);
}

.fact-value {
  font-size: 0.98rem;
  font-weight: 600;
  line-height: 1.5;
  color: var(--color-heading);
  overflow-wrap: anywhere;
}

.about-services {
  margin-top: 3rem;
}

.about-services h2 {
  margin: 0 0 1.5rem;
  font-size: 1.5rem;
}

.services-list {
  display: grid;
  grid-template-columns: repeat(1, 1fr);
  gap: 0.75rem 2rem;
  list-style: none;
  padding: 0;
  margin: 0;
}

.service-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 0.95rem;
  line-height: 1.5;
}

.service-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--sc);
}

.about-nav {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.5rem;
  margin-top: 1rem;
}

.about-link {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-top: 4px solid var(--color-urban);
  border-radius: 14px;
  padding: 1.5rem 2.75rem 1.5rem 1.5rem;
  text-decoration: none;
  color: inherit;
  box-shadow: var(--shadow-card);
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.about-link strong {
  font-family: "Roboto Slab", serif;
  color: var(--color-heading);
  font-size: 1.1rem;
}

.about-link span {
  font-size: 0.95rem;
  color: var(--color-text);
}

.about-link .link-arrow {
  position: absolute;
  top: 1.5rem;
  right: 1.25rem;
  font-size: 1.25rem;
  color: var(--color-heading);
  transition: transform 0.25s ease;
}

.about-link:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px rgba(30, 43, 51, 0.12);
  border-color: var(--color-heading);
}

.about-link:hover .link-arrow {
  transform: translateX(4px);
}

@media (max-width: 900px) {
  .intro-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}

@media (max-width: 600px) {
  .about-page {
    padding: 1.5rem 1rem;
  }

  .services-list {
    grid-template-columns: 1fr;
  }
}

</style>
