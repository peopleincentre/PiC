---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

const team = await getCollection("team");

const coreOrder = ["Alka Palrecha", "Vivek Rawal", "Rajendra Makwana"];

const pastOrder = [
  "Juhi Desai",
  "Rushank Mehta",
  "Hiranya Kalakuri",
  "Shweta Sundar",
  "Aashini Sheth",
  "Charmi Patel",
  "Mukta Ramola",
  "Yogesh Saini",
  "Mahima Gupta",
  "Deepak Bohra",
  "Ravi Inderjit Singh",
  "Maulik Rathod",
  "Sejal Gandhi",
  "Sidhha Shah",
  "Deepa Kulkarni",
  "Vipashyana Priyadarshi",
  "Alok D'Souza",
  "Rishi Pathak",
  "Teja Malladi",
  "Harshit Kothari",
  "Chintan Gohil",
];

const core = team
  .filter((member) => member.data.category === "core")
  .sort(
    (a, b) => coreOrder.indexOf(a.data.name) - coreOrder.indexOf(b.data.name)
  );

const past = team
  .filter((member) => member.data.category === "past")
  .sort(
    (a, b) => pastOrder.indexOf(a.data.name) - pastOrder.indexOf(b.data.name)
  );
---

<BaseLayout title="Team">

<main class="team-page">

<h1>Team</h1>

<section class="team-section">

<h2>Core Team</h2>

<div class="team-grid core">

{core.map((member) => (
  <article class="team-card">
    <div class="card-photo">
      {member.data.photo && (
        <img
          src={`${base}${member.data.photo.replace(/^\//, "")}`}
          alt={member.data.name}
          loading="lazy"
        />
      )}
    </div>
    <div class="card-body">
      <h3>{member.data.name}</h3>
      {member.data.designation && (
        <p class="team-role">{member.data.designation}</p>
      )}
      <p class="team-bio">{member.data.bio}</p>
      {member.data.email && (
        <a class="team-email" href={`mailto:${member.data.email}`}>
          {member.data.email}
        </a>
      )}
    </div>
  </article>
))}

</div>

</section>

<section class="team-section">

<h2>Past Team Members</h2>

<div class="team-grid past">

{past.map((member) => (
  <article class="team-card past-card">
    <div class="card-photo">
      {member.data.photo && (
        <img
          src={`${base}${member.data.photo.replace(/^\//, "")}`}
          alt={member.data.name}
          loading="lazy"
        />
      )}
    </div>
    <div class="card-body">
      <h3>{member.data.name}</h3>
      {member.data.designation && (
        <p class="team-role">{member.data.designation}</p>
      )}
      <p class="team-bio">{member.data.bio}</p>
    </div>
  </article>
))}

</div>

</section>

</main>

</BaseLayout>

<style>

.team-page {
  max-width: 1100px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
}

.team-page h1 {
  margin-bottom: 2rem;
  line-height: 2.5rem;
}

.team-section {
  margin-bottom: 3rem;
}

.team-section h2 {
  margin-bottom: 1.5rem;
}

.team-grid {
  display: grid;
  gap: 1.5rem;
  align-items: stretch;
}

.team-grid.core {
  grid-template-columns: repeat(4, 1fr);
}

.team-grid.past {
  grid-template-columns: repeat(5, 1fr);
  gap: 1rem;
  background: #2f2f2f;
  border-radius: 12px;
  padding: 1.5rem;
}

.team-card {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.team-card .card-photo {
  margin: 0;
}

.team-card .card-photo img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

.team-card .card-body {
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.team-card h3 {
  margin: 0 0 0.25rem;
  font-size: 1.05rem;
  line-height: 1.3;
}

.team-role {
  margin: 0 0 0.5rem;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #6b7280;
}

.team-bio {
  margin: 0;
  font-size: 0.92rem;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.team-email {
  margin-top: auto;
  padding-top: 0.75rem;
  font-size: 0.88rem;
  color: var(--color-urban);
  text-decoration: none;
}

.team-email:hover {
  text-decoration: underline;
}

.team-card.past-card {
  border-radius: 8px;
}

.team-card.past-card .card-body {
  padding: 0.75rem;
}

.team-card.past-card h3 {
  font-size: 0.92rem;
  margin-bottom: 0.15rem;
}

.team-card.past-card .team-role {
  font-size: 0.68rem;
  margin-bottom: 0.35rem;
}

.team-card.past-card .team-bio {
  font-size: 0.8rem;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

@media (max-width: 1100px) {
  .team-grid.past {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 900px) {
  .team-grid.core {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .team-page {
    padding: 1.5rem 1rem;
  }

  .team-grid.core,
  .team-grid.past {
    grid-template-columns: 1fr;
  }
}

</style>
