---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

const team = await getCollection("team");

const coreOrder = ["Alka Palrecha", "Vivek Rawal", "Jesim Pais", "Juhi Desai", "Rajendra Makwana"];

const pastOrder = [
  "Rushank Mehta",
  "Hiranya Kalakuri",
  "Shweta Sundar",
  "Aashini Sheth",
  "Charmi Patel",
  "Mukta Ramola",
  "Yogesh Saini",
  "Mahima Gupta",
  "Deepak Bohra",
  "Ravi Inderjit Singh",
  "Maulik Rathod",
  "Sejal Gandhi",
  "Sidhha Shah",
  "Deepa Kulkarni",
  "Vipashyana Priyadarshi",
  "Alok D'Souza",
  "Rishi Pathak",
  "Teja Malladi",
  "Harshit Kothari",
  "Chintan Gohil",
];

const core = team
  .filter((member) => member.data.category === "core")
  .sort(
    (a, b) => coreOrder.indexOf(a.data.name) - coreOrder.indexOf(b.data.name)
  );

const past = team
  .filter((member) => member.data.category === "past")
  .sort(
    (a, b) => pastOrder.indexOf(a.data.name) - pastOrder.indexOf(b.data.name)
  );

const peopleJsonLd = team.map((member) => ({
  "@type": "Person",
  name: member.data.name,
  ...(member.data.designation ? { jobTitle: member.data.designation } : {}),
  ...(member.data.email ? { email: member.data.email } : {}),
  ...(member.data.photo
    ? { image: `${base}${member.data.photo.replace(/^\//, "")}` }
    : {}),
  worksFor: { "@id": `${import.meta.env.SITE}${base}#organization` },
}));
---

<BaseLayout
  title="Team"
  description="Meet the core and past team of People in Centre — researchers, planners and practitioners working on people-centred recovery, ecology, urban spaces and other institutional initiatives."
  jsonLd={peopleJsonLd}
>

<div class="team-page">

<h1>Team</h1>

<section class="team-section">

<h2>Core Team</h2>

<div class="team-grid core">

{core.map((member) => (
  <article
    class="team-card core-card"
    role="button"
    tabindex="0"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-label={`Read full bio of ${member.data.name}`}
    data-name={member.data.name}
    data-photo={member.data.photo}
    data-designation={member.data.designation}
    data-email={member.data.email}
    data-bio={member.data.bio}
  >
    <div class="card-photo">
      {member.data.photo && (
        <img
          src={`${base}${member.data.photo.replace(/^\//, "")}`}
          alt={member.data.name}
          loading="lazy"
                  decoding="async"
        />
      )}
    </div>
    <div class="card-body">
      <h3>{member.data.name}</h3>
      {member.data.designation && (
        <p class="team-role">{member.data.designation}</p>
      )}
      <p class="team-bio">{member.data.bio}</p>
    </div>
  </article>
))}

</div>

</section>

<section class="team-section">

<h2>Past Team Members</h2>

<div class="team-grid past">

{past.map((member) => (
  <article class="team-card past-card">
    <div class="card-photo">
      {member.data.photo && (
        <img
          src={`${base}${member.data.photo.replace(/^\//, "")}`}
          alt={member.data.name}
          loading="lazy"
                  decoding="async"
        />
      )}
    </div>
    <div class="card-body">
      <h3>{member.data.name}</h3>
      {member.data.designation && (
        <p class="team-role">{member.data.designation}</p>
      )}
      <p class="team-bio">{member.data.bio}</p>
    </div>
  </article>
))}

</div>

</section>

<dialog class="member-dialog" aria-label="Core team member bio">
  <div class="dialog-inner">
    <button
      class="dialog-close"
      type="button"
      aria-label="Close bio"
    >
      &times;
    </button>
    <div class="dialog-photo" id="member-dialog-photo">
      <img src="" alt="" />
    </div>
    <div class="dialog-body">
      <h3 id="member-dialog-name"></h3>
      <p class="dialog-role"></p>
      <p class="dialog-bio"></p>
      <a class="dialog-email" href=""></a>
    </div>
  </div>
</dialog>

</div>

</BaseLayout>

<script>
  const cards = Array.from(document.querySelectorAll(".team-card.core-card"));
  const dialog = document.querySelector(".member-dialog");
  if (dialog) {
    const photoBox = dialog.querySelector("#member-dialog-photo");
    const photo = dialog.querySelector("#member-dialog-photo img");
    const name = dialog.querySelector("#member-dialog-name");
    const role = dialog.querySelector(".dialog-role");
    const bio = dialog.querySelector(".dialog-bio");
    const email = dialog.querySelector(".dialog-email");
    const closeBtn = dialog.querySelector(".dialog-close");

    let lastFocused = null;

    function fillCard(card) {
      photo.src = card.dataset.photo
        ? `${import.meta.env.BASE_URL}${card.dataset.photo.replace(/^\//, "")}`
        : "";
      photo.alt = card.dataset.name || "";
      photoBox.hidden = !card.dataset.photo;
      name.textContent = card.dataset.name || "";
      role.textContent = card.dataset.designation || "";
      role.hidden = !card.dataset.designation;
      bio.textContent = card.dataset.bio || "";
      if (card.dataset.email) {
        email.href = `mailto:${card.dataset.email}`;
        email.textContent = card.dataset.email;
        email.hidden = false;
      } else {
        email.hidden = true;
      }
    }

    function openDialog(event) {
      const card = event.currentTarget;
      fillCard(card);
      lastFocused = card;
      card.setAttribute("aria-expanded", "true");
      dialog.showModal();
      document.body.style.overflow = "hidden";
      if (!closeBtn) return;
      window.setTimeout(() => closeBtn.focus(), 0);
    }

    function closeDialog() {
      if (dialog.open) dialog.close();
    }

    cards.forEach((card) => {
      card.addEventListener("click", openDialog);
      card.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          openDialog({ currentTarget: card });
        }
      });
    });

    closeBtn?.addEventListener("click", closeDialog);

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeDialog();
    });

    dialog.addEventListener("close", () => {
      document.body.style.overflow = "";
      cards.forEach((card) => card.setAttribute("aria-expanded", "false"));
      if (lastFocused) {
        lastFocused.focus();
        lastFocused = null;
      }
    });
  }
</script>

<style>

.team-page {
  max-width: 1100px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
}

.team-page h1 {
  margin-bottom: 2rem;
  line-height: 2.5rem;
}

.team-section {
  margin-bottom: 3rem;
}

.team-section h2 {
  margin-bottom: 1.5rem;
}

.team-grid {
  display: grid;
  gap: 1.5rem;
  align-items: stretch;
}

.team-grid.core {
  grid-template-columns: repeat(4, 1fr);
}

.team-grid.past {
  grid-template-columns: repeat(5, 1fr);
  gap: 1rem;
  background: var(--color-heading);
  border-radius: 12px;
  padding: 1.5rem;
}

.team-card {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.team-card .card-photo {
  margin: 0;
}

.team-card .card-photo img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

.team-card .card-body {
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.team-card h3 {
  margin: 0 0 0.25rem;
  font-size: 1.05rem;
  line-height: 1.3;
}

.team-role {
  margin: 0 0 0.5rem;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-muted);
}

.team-bio {
  margin: 0;
  font-size: 0.92rem;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.team-card.core-card {
  cursor: pointer;
  transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
}

.team-card.core-card:hover {
  box-shadow: 0 6px 18px rgba(15, 23, 42, 0.1);
  transform: translateY(-2px);
  border-color: var(--color-urban);
}

.team-card.core-card:focus-visible {
  outline: 2px solid var(--color-urban);
  outline-offset: 2px;
}

.member-dialog {
  padding: 0;
  border: none;
  border-radius: 16px;
  width: min(760px, calc(100vw - 2rem));
  max-height: calc(100vh - 2rem);
  overflow: hidden;
  box-shadow: 0 24px 60px rgba(15, 23, 42, 0.35);
}

.member-dialog::backdrop {
  background: rgba(12, 12, 14, 0.6);
  -webkit-backdrop-filter: blur(3px);
  backdrop-filter: blur(3px);
}

.member-dialog[open] {
  animation: dialog-in 0.2s ease;
}

@keyframes dialog-in {
  from {
    opacity: 0;
    transform: translateY(12px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.dialog-inner {
  position: relative;
  display: grid;
  grid-template-columns: 260px 1fr;
  max-height: calc(100vh - 2rem);
  overflow: auto;
}

.dialog-photo img {
  display: block;
  width: 100%;
  height: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

.dialog-body {
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.5rem;
}

.dialog-close {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  width: 2rem;
  height: 2rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.92);
  color: var(--color-heading);
  font-size: 1.35rem;
  line-height: 1;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.2);
}

.dialog-close:hover {
  background: #fff;
}

.dialog-close:focus-visible {
  outline: 2px solid var(--color-urban);
  outline-offset: 2px;
}

.dialog-body h3 {
  margin: 0;
  font-size: 1.4rem;
  line-height: 1.3;
  padding-right: 2.5rem;
}

.dialog-role {
  margin: 0;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-muted);
}

.dialog-bio {
  margin: 0.5rem 0 0;
  font-size: 0.98rem;
  line-height: 1.6;
}

.dialog-email {
  margin-top: auto;
  padding-top: 1rem;
  font-size: 0.92rem;
  color: var(--color-urban);
  text-decoration: none;
}

.dialog-email:hover {
  text-decoration: underline;
}

@media (max-width: 600px) {
  .dialog-inner {
    grid-template-columns: 1fr;
  }

  .dialog-photo img {
    aspect-ratio: 16 / 10;
  }
}

.team-card.past-card {
  border-radius: 8px;
}

.team-card.past-card .card-body {
  padding: 0.75rem;
}

.team-card.past-card h3 {
  font-size: 0.92rem;
  margin-bottom: 0.15rem;
}

.team-card.past-card .team-role {
  font-size: 0.68rem;
  margin-bottom: 0.35rem;
}

.team-card.past-card .team-bio {
  font-size: 0.8rem;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

@media (max-width: 1100px) {
  .team-grid.past {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 900px) {
  .team-grid.core {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .team-page {
    padding: 1.5rem 1rem;
  }

  .team-grid.core,
  .team-grid.past {
    grid-template-columns: 1fr;
  }
}

</style>
