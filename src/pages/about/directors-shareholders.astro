---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

const governance = await getCollection("governance");

const directorsOrder = ["Rajesh Shah", "Vivek Rawal", "Alka Palrecha"];

const shareholdersOrder = [
  "P Thamizoli",
  "Prashant Hedao",
  "Dharmesh Jadeja",
  "Somnath Bandyopadhyay",
  "Rajesh Shah",
  "Vivek Rawal",
  "Alka Palrecha",
];

const sortByName = (order) => (a, b) =>
  order.indexOf(a.data.name) - order.indexOf(b.data.name);

const directors = governance
  .filter((g) => g.data.kind === "director")
  .sort(sortByName(directorsOrder));

const shareholders = governance
  .filter((g) => g.data.kind === "shareholder" || g.data.isShareholder)
  .sort(sortByName(shareholdersOrder));
---

<BaseLayout title="Directors and Shareholders">

<main class="governance-page">

<h1>Directors and Shareholders</h1>

<section class="governance-section">

<h2>Directors</h2>

<div class="directors-grid">

{directors.map((person) => (
  <article class="director-card">
    <div class="card-photo">
      {person.data.photo && (
        <img
          src={`${base}${person.data.photo.replace(/^\//, "")}`}
          alt={person.data.name}
          loading="lazy"
        />
      )}
    </div>
    <div class="card-body">
      <h3>{person.data.name}</h3>
      {person.data.designation && (
        <p class="gov-role">{person.data.designation}</p>
      )}
    </div>
  </article>
))}

</div>

</section>

<section class="governance-section">

<h2>Shareholders</h2>

<div class="shareholders-grid">

{shareholders.map((person) => (
  <article class="shareholder-card">
    <div class="card-photo">
      {person.data.photo && (
        <img
          src={`${base}${person.data.photo.replace(/^\//, "")}`}
          alt={person.data.name}
          loading="lazy"
        />
      )}
    </div>
    <div class="card-body">
      <h3>{person.data.name}</h3>
    </div>
  </article>
))}

</div>

</section>

</main>

</BaseLayout>

<style>

.governance-page {
  max-width: 1000px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
}

.governance-page h1 {
  margin-bottom: 2rem;
  line-height: 2.5rem;
}

.governance-section {
  margin-bottom: 3rem;
}

.governance-section h2 {
  margin-bottom: 1.5rem;
}

.directors-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  align-items: stretch;
}

.shareholders-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  background: var(--color-heading);
  border-radius: 12px;
  padding: 1.5rem;
  align-items: stretch;
}

.director-card,
.shareholder-card {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.shareholder-card {
  border-radius: 8px;
}

.card-photo {
  margin: 0;
}

.card-photo img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

.card-body {
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  flex: 1;
  text-align: center;
}

.shareholder-card .card-body {
  padding: 0.85rem;
}

.card-body h3 {
  margin: 0 0 0.25rem;
  font-size: 1.05rem;
  line-height: 1.3;
}

.shareholder-card h3 {
  font-size: 0.95rem;
  margin-bottom: 0;
}

.gov-role {
  margin: 0;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-muted);
}

@media (max-width: 900px) {
  .directors-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .shareholders-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 600px) {
  .governance-page {
    padding: 1.5rem 1rem;
  }

  .directors-grid,
  .shareholders-grid {
    grid-template-columns: 1fr;
  }
}

</style>
