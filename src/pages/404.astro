---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Page Not Found"
  description="The page you are looking for could not be found."
  robots="noindex, follow"
>

<div class="notfound-page">

<h1>Page Not Found</h1>

<p>
  The page you are looking for could not be found. It may have been moved or
  no longer exists.
</p>

<p>
  <a href={base}>Return to the home page</a>
</p>

</div>

</BaseLayout>

<style>
.notfound-page {
  max-width: 700px;
  margin: 0 auto;
  padding: 4rem 1.5rem;
  text-align: center;
}

.notfound-page h1 {
  margin-bottom: 1rem;
}

.notfound-page a {
  color: var(--color-urban);
}
</style>
