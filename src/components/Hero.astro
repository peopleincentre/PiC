---
const base = import.meta.env.BASE_URL;

const rotatingPhrases = [
  "Reinforcing People's Resilience to Disasters",
  "Restructuring Human Interventions for Ecological Balance",
  "Reclaiming Urban Space for the People",
  "Reconnecting Research with the Socio-Economic Realities of Communities",
];
---

<section class="hero">
  <div
    class="hero-bg"
    style={`background-image: url(${base}images/hero.jpg);`}
  >
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <p class="hero-eyebrow">People in Centre works across four thematic areas</p>
      <h1 class="hero-headline" id="hero-headline" aria-live="polite">
        {rotatingPhrases[0]}
      </h1>
    </div>
  </div>
</section>

<section class="hero-intro">
  <div class="hero-intro-inner">
    <p class="hero-statement">
      <strong>People in Centre Consulting (PiC)</strong> is committed to
      bringing poor and vulnerable communities to the centre of development
      processes. We work to create conditions in which people are not passive
      recipients of assistance but active participants in shaping, managing,
      and owning their development. Through research, planning, implementation
      support, capacity building, and knowledge generation, we help governments,
      international agencies, and civil society organisations build programmes
      that strengthen local capacities, promote socially just solutions, and
      achieve lasting change.
    </p>

    <p class="pillars-lead">
      PiC's approach rests on three fundamental shifts.
    </p>

    <div class="pillars">
      <div class="pillar">
        <h3 class="pillar-title">From Infrastructure to People</h3>
        <p>
          Putting communities at the centre of every intervention, not just
          buildings and systems.
        </p>
      </div>
      <div class="pillar">
        <h3 class="pillar-title">From Projects to Processes</h3>
        <p>
          Supporting the long-term processes, capacities and institutions that
          make change last.
        </p>
      </div>
      <div class="pillar">
        <h3 class="pillar-title">From Delivery to Participation</h3>
        <p>
          Enabling people to shape, manage and own their development, rather
          than merely receive it.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const phrases = [
    "Reinforcing People's Resilience to Disasters",
    "Restructuring Human Interventions for Ecological Balance",
    "Reclaiming Urban Space for the People",
    "Reconnecting Research with the Socio-Economic Realities of Communities",
  ];

  const headline = document.getElementById("hero-headline");
  let index = 0;

  const rotate = () => {
    index = (index + 1) % phrases.length;
    headline?.classList.add("fade-out");
    setTimeout(() => {
      if (headline) {
        headline.textContent = phrases[index];
        headline.classList.remove("fade-out");
      }
    }, 250);
  };

  setInterval(rotate, 4500);
</script>

<style>
  .hero {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    background: var(--color-heading);
    padding: 0;
  }

  .hero-bg {
    position: relative;
    min-height: 72vh;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(18, 32, 38, 0.55) 0%,
      rgba(18, 32, 38, 0.35) 50%,
      rgba(18, 32, 38, 0.72) 100%
    );
  }

  .hero-content {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 2rem;
    text-align: center;
    color: #fff;
  }

  .hero-eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    opacity: 0.85;
  }

  .hero-headline {
    margin: 0 0 1.5rem;
    font-family: "Roboto Slab", serif;
    font-weight: 600;
    font-size: clamp(1.9rem, 4.6vw, 3.6rem);
    line-height: 1.15;
    color: #fff;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
    opacity: 1;
    transition: opacity 0.25s ease;
  }

  .hero-headline.fade-out {
    opacity: 0;
  }

  .hero-intro {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    background: color-mix(in srgb, var(--color-heading) 18%, var(--color-surface));
    color: var(--color-heading);
    padding: 1rem;
  }

  .hero-intro-inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  .hero-statement {
    max-width: 980px;
    font-family: "Roboto Slab", serif;
    font-size: clamp(1.15rem, 1.8vw, 1.30rem);
    font-weight: 400;
    line-height: 1.8;
    color: var(--color-heading);
  }

  .hero-statement strong {
    font-weight: 600;
    color: var(--color-heading);
  }

  .pillars-lead {
    margin: 1rem 0 0;
     font-family: "Roboto Slab", serif;
    font-size: clamp(1.15rem, 1.8vw, 1.30rem);
    font-weight: 400;
    line-height: 1.8;
    color: var(--color-heading);
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding-top: 1rem;
  }

  .pillar + .pillar {
    border-left: 2px solid var(--color-heading);
    padding-left: 1rem;
  }

  .pillar {
    padding-right: 0;
    text-align: left;
  }

  .pillar-title {
    margin: 0 0 0.5rem;
    font-family: "Roboto Slab", serif;
    font-size: 1.30rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-heading);
  }

  .pillar p {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.5;
    color: #5b6368;
  }

  @media (max-width: 700px) {
    .hero-bg {
      min-height: 64vh;
    }

    .hero-content {
      padding: 3rem 1.25rem;
    }

    .hero-intro {
      padding: 3rem 1.25rem;
    }

    .pillars {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      margin-top: 2.5rem;
      padding-top: 2rem;
    }

    .pillar + .pillar {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--color-border);
      padding-top: 1.75rem;
    }

    .pillar {
      padding-right: 0;
    }
  }
</style>
