---
const base = import.meta.env.BASE_URL;

const rotatingPhrases = [
  "Reinforcing People's Resilience to Disasters",
  "Restructuring Human Interventions for Ecological Balance",
  "Reclaiming Urban Space for the People",
  "Re-grounding Research in Socio-Economic Community Realities",
];
---

<section class="hero">
  <div
    class="hero-bg"
    style={`background-image: url(${base}images/hero.jpg);`}
  >
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <p class="hero-eyebrow">People in Centre works across four thematic areas</p>
      <h1 class="hero-headline" id="hero-headline" aria-live="polite">
        {rotatingPhrases[0]}
      </h1>
      <p class="hero-tagline">
        Shifting the focus from infrastructure to people, from projects to
        processes, from delivery to participation.
      </p>
    </div>
  </div>
</section>

<section class="hero-intro">
  <p>
    <strong>People in Centre (PiC)</strong> works to place people at the heart of
    development, recovery and change. We support communities, governments and
    development partners in creating resilient, sustainable and inclusive
    solutions through work on resilience, ecological balance, urban space and
    capacity building.
  </p>
</section>

<script>
  const phrases = [
    "Reinforcing People's Resilience to Disasters",
    "Restructuring Human Interventions for Ecological Balance",
    "Reclaiming Urban Space for the People",
    "Re-grounding Research in Socio-Economic Community Realities",
  ];

  const headline = document.getElementById("hero-headline");
  let index = 0;

  const rotate = () => {
    index = (index + 1) % phrases.length;
    headline?.classList.add("fade-out");
    setTimeout(() => {
      if (headline) {
        headline.textContent = phrases[index];
        headline.classList.remove("fade-out");
      }
    }, 250);
  };

  setInterval(rotate, 4500);
</script>

<style>
  .hero {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    background: var(--color-heading);
    padding: 0;
  }

  .hero-bg {
    position: relative;
    min-height: 72vh;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(18, 32, 38, 0.55) 0%,
      rgba(18, 32, 38, 0.35) 50%,
      rgba(18, 32, 38, 0.72) 100%
    );
  }

  .hero-content {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 2rem;
    text-align: center;
    color: #fff;
  }

  .hero-eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    opacity: 0.85;
  }

  .hero-headline {
    margin: 0 0 1.5rem;
    font-family: "Roboto Slab", serif;
    font-weight: 600;
    font-size: clamp(1.9rem, 4.6vw, 3.6rem);
    line-height: 1.15;
    color: #fff;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
    opacity: 1;
    transition: opacity 0.25s ease;
  }

  .hero-headline.fade-out {
    opacity: 0;
  }

  .hero-tagline {
    margin: 0 auto;
    max-width: 720px;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    font-weight: 300;
    line-height: 1.6;
    opacity: 0.95;
  }

  .hero-intro {
    background: var(--color-surface);
    padding: 2.5rem 2rem;
    margin: 0 auto;
  }

  .hero-intro p {
    max-width: 820px;
    margin: 0 auto;
    font-size: 1.05rem;
    text-align: center;
  }

  @media (max-width: 700px) {
    .hero-bg {
      min-height: 64vh;
    }

    .hero-content {
      padding: 3rem 1.25rem;
    }

    .hero-intro {
      padding: 2rem 1.25rem;
    }
  }
</style>
