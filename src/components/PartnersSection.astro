---
const base = import.meta.env.BASE_URL;

const partners = [
  { name: "UNDP", slug: "undp", url: "https://www.undp.org/" },
  {
    name: "International Water Management Institute (IWMI)",
    slug: "iwmi",
    url: "https://www.iwmi.cgiar.org/",
  },
  {
    name: "International Development Economics Associates (IDEAs)",
    slug: "IDEAs",
    url: "https://networkideas.org/",
  },
  {
    name: "National Disaster Management Authority (NDMA)",
    slug: "ndma",
    url: "https://ndma.gov.in/",
  },
  {
    name: "Government of Gujarat",
    slug: "gujarat",
    url: "https://gujaratindia.gov.in/",
  },
  {
    name: "AKRSP (India)",
    slug: "akrsp",
    url: "https://www.akrspindia.org.in/",
  },
  {
    name: "Owner Driven Reconstruction Collaborative (ODRC)",
    slug: "ODRC",
    url: "",
  },
  {
    name: "CEPT University",
    slug: "cept",
    url: "https://cept.ac.in/",
  },
  {
    name: "Earthquake Engineering Research Institute (EERI)",
    slug: "eeri",
    url: "https://www.eeri.org/",
  },
  {
    name: "UNNATI",
    slug: "unnati",
    url: "https://www.unnati.org/",
  },
  {
    name: "Hunnarshala Foundation",
    slug: "hunnarshala",
    url: "http://www.hunnarshala.org/",
  },
  {
    name: "Biome Environmental Trust",
    slug: "biome",
    url: "https://biometrust.org/",
  },
];
---

<section class="home-section partners-section" aria-label="Partners and Collaborators">
  <div class="section-header">
    <h2>Partners and Collaborators</h2>
    <p class="partners-subtitle">
      We work with governments, development agencies, universities and civil
      society organisations across the world.
    </p>
  </div>

  <div class="partners-viewport">
    <div class="partners-track">
      {
        [...partners, ...partners].map((partner) => {
          const classAttr = "partner-item";
          const inner = partner.chip ? (
            <span class="partner-chip">{partner.name}</span>
          ) : (
            <img
              src={`${base}images/partners/${partner.slug}.png`}
              alt={partner.name}
              loading="lazy"
              decoding="async"
              draggable="false"
            />
          );
          return partner.url ? (
            <a
              class={classAttr}
              href={partner.url}
              target="_blank"
              rel="noopener noreferrer"
              title={partner.name}
            >
              {inner}
            </a>
          ) : (
            <span class={classAttr} title={partner.name}>
              {inner}
            </span>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .partners-section {
    box-sizing: border-box;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    background: var(--color-surface);
    padding: 1.5rem 0;
    overflow: hidden;
  }

  .section-header {
    max-width: 1280px;
    margin: 0 auto 1.5rem;
    padding-inline: 1rem;
    text-align: center;
  }

  .section-header h2 {
    margin: 0 0 0.5rem;
    font-family: "Roboto Slab", serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 600;
  }

  .section-header .tagline {
    justify-content: center;
  }

  .partners-subtitle {
    margin: 0;
    color: var(--color-muted);
    font-size: 1rem;
    max-width: 640px;
    margin-inline: auto;
  }

  .partners-viewport {
    overflow: hidden;
    width: 100%;
  }

  .partners-track {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
    animation: partners-scroll 40s linear infinite;
  }

  .partners-viewport:hover .partners-track,
  .partners-track:focus-within {
    animation-play-state: paused;
  }

  @keyframes partners-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .partner-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(140px, 16vw, 220px);
    height: clamp(60px, 7vw, 88px);
    margin-right: clamp(1.25rem, 2.5vw, 2.5rem);
    padding: 0 1rem;
    text-decoration: none;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .partner-item:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-card-hover);
  }

  .partner-item img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 1;
    transition: filter 0.3s ease, opacity 0.3s ease;
  }

  .partner-item:hover img {
    filter: grayscale(0%);
    opacity: 1;
  }

  .partner-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: "Roboto Slab", serif;
    font-weight: 500;
    font-size: clamp(0.7rem, 1.4vw, 0.9rem);
    text-align: center;
    line-height: 1.4;
    color: var(--color-heading);
    white-space: normal;
    opacity: 0.75;
    transition: opacity 0.3s ease, color 0.3s ease;
  }

  .partner-item:hover .partner-chip {
    opacity: 1;
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .partners-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      gap: 1.25rem;
    }

    .partner-item {
      margin-right: 0;
    }
  }

  @media (min-width: 768px) {
    .section-header {
      padding-inline: 2rem;
    }
  }

  @media (max-width: 640px) {
    .partners-section {
      padding: 2rem 0;
    }
  }
</style>
