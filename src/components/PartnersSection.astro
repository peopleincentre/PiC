---
const base = import.meta.env.BASE_URL;

const partners = [
  { name: "UNDP", slug: "undp", url: "https://www.undp.org/", tall: true },
  {
    name: "International Water Management Institute (IWMI)",
    slug: "iwmi",
    url: "https://www.iwmi.cgiar.org/",
  },
  {
    name: "National Disaster Management Authority (NDMA)",
    slug: "ndma",
    url: "https://ndma.gov.in/",
  },
  {
    name: "Government of Gujarat",
    slug: "gujarat",
    url: "https://gujaratindia.gov.in/",
  },
  {
    name: "AKRSP (India)",
    slug: "akrsp",
    url: "https://www.akrspindia.org.in/",
  },
  {
    name: "Owner Driven Reconstruction Collaborative (ODRC)",
    chip: true,
    url: "https://odrcollaborative.net/",
  },
  {
    name: "CEPT University",
    slug: "cept",
    url: "https://cept.ac.in/",
  },
  {
    name: "Earthquake Engineering Research Institute (EERI)",
    slug: "eeri",
    url: "https://www.eeri.org/",
  },
  {
    name: "UNNATI",
    slug: "unnati",
    url: "https://www.unnati.org/",
  },
  {
    name: "Hunnarshala Foundation",
    chip: true,
    url: "https://www.hunnarshala.org/",
  },
  {
    name: "Biome Environmental Trust",
    slug: "biome",
    url: "https://biometrust.org/",
  },
];
---

<section class="home-section partners-section" aria-label="Partners and Collaborators">
  <div class="section-header">
    <h2>Partners and Collaborators</h2>
    <p class="partners-subtitle">
      We work with governments, development agencies, universities and civil
      society organisations across the world.
    </p>
  </div>

  <div class="partners-viewport">
    <div class="partners-track">
      {
        [...partners, ...partners].map((partner) => (
          <a
            class={`partner-item${partner.tall ? " partner-item--tall" : ""}`}
            href={partner.url}
            target="_blank"
            rel="noopener noreferrer"
            title={partner.name}
          >
            {
              partner.chip ? (
                <span class="partner-chip">{partner.name}</span>
              ) : (
                <img
                  src={`${base}images/partners/${partner.slug}.png`}
                  alt={partner.name}
                  loading="lazy"
                  draggable="false"
                />
              )
            }
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .partners-section {
    background: var(--color-bg);
    padding: 3rem 2rem;
    overflow: hidden;
  }

  .section-header {
    margin-bottom: 2rem;
  }

  .section-header h2 {
    margin: 0 0 0.5rem;
  }

  .partners-subtitle {
    margin: 0;
    color: #6b7280;
    font-size: 0.95rem;
  }

  .partners-viewport {
    overflow: hidden;
    width: 100%;
  }

  .partners-track {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
    animation: partners-scroll 40s linear infinite;
  }

  .partners-viewport:hover .partners-track,
  .partners-track:focus-within {
    animation-play-state: paused;
  }

  @keyframes partners-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .partner-item {
    display: inline-flex;
    align-items: center;
    margin-right: 3rem;
    text-decoration: none;
  }

  .partner-item img {
    height: 44px;
    width: auto;
    max-width: 240px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
    transition:
      filter 0.3s ease,
      opacity 0.3s ease;
  }

  .partner-item--tall img {
    height: 60px;
    max-width: none;
  }

  .partner-item:hover img {
    filter: grayscale(0);
    opacity: 1;
  }

  .partner-chip {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: #fff;
    color: var(--color-heading);
    font-family: "Roboto Slab", serif;
    font-weight: 500;
    font-size: 0.95rem;
    white-space: nowrap;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .partner-item:hover .partner-chip {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .partners-track {
      animation: none;
    }

    .partners-viewport {
      overflow-x: auto;
    }
  }

  @media (max-width: 640px) {
    .partners-section {
      padding: 2.5rem 1rem;
    }

    .partner-item {
      margin-right: 2rem;
    }

    .partner-item img {
      height: 36px;
    }

    .partner-item--tall img {
      height: 50px;
    }
  }
</style>
