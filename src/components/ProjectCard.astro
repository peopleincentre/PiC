---
const { project } = Astro.props;

const base = import.meta.env.BASE_URL;

const {
  title,
  summary,
  country,
  startYear,
  endYear,
  client,
  coverImage,
  themes
} = project.data;

const themeColors = {
  "ecological-balance": "var(--color-ecology)",
  resilience: "var(--color-resilience)",
  "urban-space": "var(--color-urban)",
  "institutional-initiatives": "var(--color-capacity)",
};
const accent =
  themeColors[themes && themes[0]] || "var(--color-heading)";
---

<a
  href={`${base}work/projects/${project.id}/`}
  class="card-link"
>
  <article class="card" style={`--accent: ${accent}`}>

   {coverImage ? (
    <div class="image-wrapper">
     <img
      src={`${base}${coverImage.replace(/^\//, "")}`}
      alt={title}
      class="card-image"
     />
    </div>
   ) : (
    <div class="image-placeholder" aria-hidden="true"></div>
   )}

    <div class="card-content">

      <h3>{title}</h3>

      <p class="summary">
        {summary}
      </p>

      <div class="meta">
        {country && (
          <p>
            <strong>Country:</strong> {country}
          </p>
        )}

        {(startYear || endYear) && (
          <p>
            <strong>Duration:</strong>
            {startYear && endYear
              ? `${startYear}–${endYear}`
              : endYear || startYear}
          </p>
        )}

        {client && (
          <p>
            <strong>Client:</strong> {client}
          </p>
        )}
      </div>

    </div>

  </article>
</a>

<style>

.card-link {
  text-decoration: none;
  color: inherit;
  display: block;
  height: 100%;
}

.card {
  border: 1px solid #ddd;
  border-radius: 6px;
  overflow: hidden;
  background: white;
  display: flex;
  flex-direction: column;
  height: 100%;
  transition: border-color 0.2s ease;
}

.card:hover {
  border-color: var(--accent);
}

.image-wrapper {
  width: 100%;
}

.card-image {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  display: block;
}

.image-placeholder {
  width: 100%;
  aspect-ratio: 16 / 9;
  background: var(--color-surface);
}

.card-content {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.card h3 {
  margin-top: 0;
  margin-bottom: 0.5rem;
  font-size: 1rem;
  line-height: 1.3;
  color: var(--accent);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.summary {
  margin: 0 0 0.75rem;
  line-height: 1.3;
  font-size: 0.9rem;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.meta {
  font-size: 0.9rem;
  margin-top: auto;
}

.meta p {
  margin: 0.25rem 0;
}

</style>
