---
const base = import.meta.env.BASE_URL;

const currentPath = Astro.url.pathname.replace(
  new RegExp(`^${base.replace(/\/$/, "")}`),
  ""
);
const segments = currentPath.split("/").filter(Boolean);
const currentSection = segments[0] || "home";

const navItems = [
  { label: "Home", href: base, section: "home" },
  { label: "About Us", href: `${base}about/`, section: "about" },
  { label: "Our Work", href: `${base}work/`, section: "work" },
  {
    label: "Knowledge Resources",
    href: `${base}resources/`,
    section: "resources",
  },
  { label: "Contact", href: `${base}contact/`, section: "contact" },
];

const activeClass = (section) =>
  section === currentSection ? " is-active" : "";
const activeAria = (section) =>
  section === currentSection ? { "aria-current": "page" } : {};
---

<header id="site-header">
  <nav class="nav-bar">
    <a href={base} class="site-brand">
    <img
      src={`${base}images/logo.png`}
      alt="People in Centre"
    />
    </a>

    <div class="menu menu-desktop">
      {
        navItems.map(
          (item) => (
            <a
              href={item.href}
              class={activeClass(item.section)}
              {...activeAria(item.section)}
            >
              {item.label}
            </a>
          )
        )
      }
    </div>

    <button
      class="menu-toggle"
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-drawer"
      aria-label="Open menu"
    >
      <span class="hamburger" aria-hidden="true"></span>
    </button>
  </nav>
</header>

<div class="drawer-backdrop" id="drawer-backdrop" hidden></div>

<aside class="drawer" id="site-drawer" aria-hidden="true">
  <nav class="menu menu-drawer">
    {
      navItems.map(
        (item) => (
          <a
            href={item.href}
            class={activeClass(item.section)}
            {...activeAria(item.section)}
          >
            {item.label}
          </a>
        )
      )
    }
  </nav>
</aside>

<script>
  const toggle = document.getElementById("menu-toggle");
  const drawer = document.getElementById("site-drawer");
  const backdrop = document.getElementById("drawer-backdrop");
  const links = Array.from(drawer?.querySelectorAll("a") || []);

  function open() {
    if (!drawer || !backdrop) return;
    toggle?.setAttribute("aria-expanded", "true");
    toggle?.setAttribute("aria-label", "Close menu");
    drawer.classList.add("is-open");
    drawer.setAttribute("aria-hidden", "false");
    backdrop.hidden = false;
    document.body.style.overflow = "hidden";
  }

  function close() {
    if (!drawer || !backdrop) return;
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Open menu");
    drawer.classList.remove("is-open");
    drawer.setAttribute("aria-hidden", "true");
    backdrop.hidden = true;
    document.body.style.overflow = "";
  }

  toggle?.addEventListener("click", () => {
    if (toggle.getAttribute("aria-expanded") === "true") {
      close();
    } else {
      open();
    }
  });

  backdrop?.addEventListener("click", close);
  links.forEach((link) => link.addEventListener("click", close));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") close();
  });

  window.addEventListener("resize", () => {
    if (window.matchMedia("(min-width: 769px)").matches) {
      close();
    }
  });
</script>

<style>
header {
  position: sticky;
  top: 0;
  z-index: 1000;

  box-sizing: border-box;
  width: 100vw;
  margin-left: calc(50% - 50vw);

  padding: 0;
  background: rgba(30, 41, 59, 0.82);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  color: white;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0.75rem 1rem;
  min-height: 64px;
}

.site-brand {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  text-decoration: none;
  color: white;
}

.site-brand img {
  height: 42px;
  width: auto;
  display: block;
}

.brand-name {
  font-family: "Roboto Slab", serif;
  font-size: 1.05rem;
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: 0.01em;
}

.menu a {
  text-decoration: none;
  color: inherit;
  font-family: "Plus Jakarta Sans", sans-serif;
  font-size: 0.95rem;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.menu a:hover {
  opacity: 0.85;
}

.menu a.is-active {
  position: relative;
  color: #fff;
}

.menu a.is-active::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -8px;
  height: 2px;
  border-radius: 2px;
  background: var(--color-accent);
}

.menu-desktop {
  display: none;
}

.menu-toggle {
  display: none;
  border: none;
  background: transparent;
  padding: 0.5rem;
  cursor: pointer;
  border-radius: 8px;
  color: white;
}

.menu-toggle:hover {
  opacity: 0.85;
}

.hamburger,
.hamburger::before,
.hamburger::after {
  display: block;
  width: 26px;
  height: 3px;
  border-radius: 2px;
  background: currentColor;
  content: "";
}

.hamburger {
  position: relative;
}

.hamburger::before {
  position: absolute;
  top: -8px;
  left: 0;
}

.hamburger::after {
  position: absolute;
  top: 8px;
  left: 0;
}

.menu-toggle[aria-expanded="true"] .hamburger {
  background: transparent;
}

.menu-toggle[aria-expanded="true"] .hamburger::before {
  top: 0;
  transform: rotate(45deg);
}

.menu-toggle[aria-expanded="true"] .hamburger::after {
  top: 0;
  transform: rotate(-45deg);
}

.drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1100;

  width: min(82vw, 340px);

  background: rgba(15, 23, 42, 0.96);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  color: white;

  padding: 5rem 2rem 2rem;

  transform: translateX(100%);
  transition: transform 0.28s ease;
  visibility: hidden;

  overflow-y: auto;
}

.drawer.is-open {
  transform: translateX(0);
  visibility: visible;
}

.drawer-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1050;
  background: rgba(13, 20, 24, 0.55);
}

.menu-drawer {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.menu-drawer a {
  font-size: 1.15rem;
  padding: 0.9rem 0.75rem;
  border-radius: 8px;
  font-weight: 600;
}

.menu-drawer a:hover {
  background: rgba(255, 255, 255, 0.1);
  opacity: 1;
}

.menu-drawer a.is-active {
  background: rgba(37, 99, 235, 0.28);
  border: 1px solid rgba(37, 99, 235, 0.5);
}

.menu-drawer a.is-active::after {
  display: none;
}

@media (min-width: 769px) {
  .menu-desktop {
    display: flex;
    gap: 2rem;
  }

  .menu-toggle {
    display: none;
  }

  .drawer,
  .drawer-backdrop {
    display: none;
  }

  .nav-bar {
    padding: 0.75rem 2rem;
  }
}

@media (max-width: 768px) {
  .menu-desktop {
    display: none;
  }

  .menu-toggle {
    display: block;
  }

  .brand-name {
    display: none;
  }
}
</style>
