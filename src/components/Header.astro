---
const base = import.meta.env.BASE_URL;
---

<header>
  <nav>
    <a href={base} class="site-brand">
    <img
      src={`${base}images/logo.png`}
      alt="People in Centre"
    />
    </a>

    <div class="menu">
      <a href={base}>Home</a>
      <a href={`${base}about/`}>About Us</a>
      <a href={`${base}work/`}>Our Work</a>
      <a href={`${base}resources/`}>Knowledge Resources</a>
      <a href={`${base}contact/`}>Contact</a>
    </div>
  </nav>
</header>

<style>
header {
  position: sticky;
  top: 0;
  z-index: 1000;

  padding: 1rem 1rem;
  background: var(--color-heading);
  color: white;
  border-bottom: none;
}

.site-brand {
  display: flex;
  align-items: center;
  gap: 0.2rem;
  text-decoration: none;
  color: white;
}

.site-brand img {
  height: 42px;
  width: auto;
  display: block;
}

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  nav > a {
    font-family: "Roboto Slab", serif;
    font-weight: bold;
    text-decoration: none;
    color: inherit;
  }

  .menu {
    display: flex;
    gap: 2.5rem;
  }

 .menu a {
  text-decoration: none;
  color: inherit;
  font-family: "Roboto Slab", serif;
  font-size: 0.95rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  }

 .menu a:hover {
  opacity: 0.8;
  }

  @media (max-width: 700px) {
    nav {
      flex-direction: column;
      gap: 1rem;
    }

    .menu {
      flex-direction: column;
      text-align: center;
      gap: 0.75rem;
    }
 
  }
</style>
