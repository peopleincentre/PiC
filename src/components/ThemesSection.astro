---
import ThemeCard from "./ThemeCard.astro";

const themes = [
  {
    title: "Reinforcing People's Resilience to Disasters",
    description:
      "Supporting communities and institutions in disaster recovery, resilient housing, risk reduction and locally appropriate solutions.",
    image: "/images/themes/resilience.jpg",  
    link: "/work/resilience"
  },

  {
    title: "Restructuring Human Interventions for Ecological Balance",
    description:
      "Exploring sustainable relationships between people and nature through water management, wastewater reuse, ecological restoration and responsible interventions.",
    image: "/images/themes/ecological-balance.jpg",  
    link: "/work/ecological-balance"
  },

  {
    title: "Reclaiming Urban Space for the People",
    description:
      "Working towards inclusive cities through people-centred planning, housing and public spaces.",
    image: "/images/themes/urban-space.jpg", 
    link: "/work/urban-space"
  },

  {
    title: "Re-grounding Research in Socio-Economic Community Realities",
    description:
      "Creating and managing platforms for research, learning, capacity building and knowledge exchange.",
    image: "/images/themes/institutional-initiatives.jpg", 
    link: "/work/institutional-initiatives"
  }
];

---

<section class="home-themes">

  <h1>
    Thematic Areas of Work
  </h1>


  <div class="theme-grid">

    {
      themes.map((theme) => (
        <ThemeCard
          title={theme.title}
          description={theme.description}
          image={theme.image}
          link={theme.link}
        />
      ))
    }

  </div>

</section>


<style>

section {
  padding: 2rem 2rem;
}

.theme-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
}


@media (max-width: 700px) {
  .theme-grid {
    grid-template-columns: 1fr;
  }

}

</style>
