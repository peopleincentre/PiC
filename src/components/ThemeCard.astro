---
const base = import.meta.env.BASE_URL;
const {
  title,
  description,
  image,
  link
} = Astro.props;
---

<article class="theme-card">

  <div class="theme-image-wrap">
    <img
     src={`${base}${image.replace(/^\//, "")}`}
     alt={title}
     class="theme-image"
     loading="lazy"
    />
  </div>

  <div class="theme-card-content">
    <h3>{title}</h3>
    <p>
      {description}
    </p>

    <a href={`${base}${link.replace(/^\//, "")}`}>
      View Projects <span aria-hidden="true">→</span>
    </a>
  </div>

</article>