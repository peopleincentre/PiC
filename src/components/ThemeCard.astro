---
const base = import.meta.env.BASE_URL;
const {
  title,
  description,
  image,
  link
} = Astro.props;
---

<article class="theme-card">

  <h3>{title}</h3>
  <img
   src={`${base}${image}`}
   alt={title}
   class="theme-image"
  />
  <p>
    {description}
  </p>

  <a href={link}>
    View Projects →
  </a>

</article>


<style>


</style>
