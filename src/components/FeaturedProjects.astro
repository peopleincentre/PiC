---
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

const allProjects = await getCollection("projects");

const byRecency = (list) =>
  [...list].sort(
    (a, b) =>
      (b.data.endYear ?? b.data.startYear ?? 0) -
      (a.data.endYear ?? a.data.startYear ?? 0)
  );

const featured = allProjects.filter(({ data }) => data.featured);

const pickTheme = (themeId, count) =>
  byRecency(
    featured.filter((p) => (p.data.themes || []).includes(themeId))
  ).slice(0, count);

const projects = [
  ...pickTheme("ecological-balance", 3),
  ...pickTheme("resilience", 3),
];
---

<section class="home-section home-projects">

  <div class="section-header">

  <h2>Featured Projects</h2>

</div>

<div class="project-strip-wrapper">

  <button
    class="project-arrow project-arrow-left"
    id="projects-prev"
    aria-label="Previous projects"
  >
    ‹
  </button>

  <button
    class="project-arrow project-arrow-right"
    id="projects-next"
    aria-label="Next projects"
  >
    ›
  </button>

  <div
    class="project-strip"
    id="project-strip"
  >

    {
      projects.map((project) => (
        <a
          href={`${base}work/projects/${project.id}/`}
          class="project-card"
        >

          {
            project.data.coverImage && (
              <span class="project-image-wrap">
                <img
                  src={`${base}${project.data.coverImage.replace(/^\//, "")}`}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </span>
            )
          }

<div class="project-card-content">
  <h4>{project.data.title}</h4>
</div>

        </a>
      ))   
    }
  </div>
</div>  

</section>

<script>
  const strip = document.getElementById("project-strip");

  document
    .getElementById("projects-next")
    ?.addEventListener("click", () => {
      strip?.scrollBy({
        left: 300,
        behavior: "smooth"
      });
    });

  document
    .getElementById("projects-prev")
    ?.addEventListener("click", () => {
      strip?.scrollBy({
        left: -300,
        behavior: "smooth"
      });
    });
</script>
