---
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");

const COUNTRY_KEYWORDS = {
  Afghanistan: /afghanistan/,
  Bhutan: /bhutan/,
  India: /india/,
  Indonesia: /indonesia|sulawesi/,
  Myanmar: /myanmar/,
  Mozambique: /mozambique/,
  Nepal: /nepal/,
  Somalia: /somalia/,
  "Sri Lanka": /sri\s*lanka|srilanka/,
  "Timor-Leste": /timor[\s-]?leste/,
};

const countrySet = new Set();

for (const project of allProjects) {
  const { title, summary, description, location, country } = project.data;
  const haystack = [title, summary, description, location, country]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();

  for (const [name, pattern] of Object.entries(COUNTRY_KEYWORDS)) {
    if (pattern.test(haystack)) countrySet.add(name);
  }
}

const countryCount = countrySet.size;
const projectCount = allProjects.length;
---

<section class="impact-section" aria-label="Our impact in numbers">
  <div class="impact-inner">
    <div class="impact-head">
      <p class="impact-eyebrow">Our Impact</p>
      <h2 class="impact-title">Working with people, where it counts</h2>
    </div>

    <div class="impact-grid">
      <div class="impact-stat">
        <span class="impact-number">{countryCount}</span>
        <span class="impact-label">Countries worked in</span>
      </div>

      <div class="impact-stat impact-stat-projects">
        <span class="impact-number">{projectCount}</span>
        <span class="impact-label">Projects managed</span>
        <ul class="impact-categories">
          <li>Assessment and evaluation</li>
          <li>Project implementation and facilitation</li>
          <li>Research and communication</li>
        </ul>
      </div>

      <div class="impact-stat">
        <span class="impact-number">40,000+</span>
        <span class="impact-label">Households served</span>
      </div>
    </div>
  </div>
</section>

<style>
  .impact-section {
    box-sizing: border-box;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    background: var(--color-dark);
    padding: 2.75rem 1.25rem;
  }

  .impact-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .impact-head {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .impact-eyebrow {
    margin: 0 0 0.5rem;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-cyan);
  }

  .impact-title {
    margin: 0;
    font-family: "Roboto Slab", serif;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 500;
    color: #fff;
  }

  .impact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: stretch;
    text-align: center;
  }

  .impact-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.5rem 1.25rem;
    background: rgba(52, 181, 245, 0.08);
    border: 1px solid rgba(52, 181, 245, 0.28);
    border-radius: var(--radius-card);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
  }

  .impact-number {
    font-family: "Roboto Slab", serif;
    font-weight: 700;
    font-size: clamp(2.6rem, 5vw, 3.8rem);
    line-height: 1;
    color: #ffffff;
  }

  .impact-label {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #cbd5e1;
    line-height: 1.5;
  }

  .impact-categories {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.6;
  }

  .impact-categories li::before {
    content: "· ";
    color: var(--color-cyan);
  }

  @media (max-width: 800px) {
    .impact-section {
      padding: 2.25rem 1.25rem;
    }

    .impact-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .impact-stat {
      padding: 1.5rem 1.25rem;
    }
  }
</style>
