---
/**
 * Scroll-reveal observer. Include once per page (e.g. in the homepage).
 * Any element with the `.reveal` class gets `.visible` added when it
 * scrolls into view, honouring each element's `--reveal-delay`.
 */
---

<script>
  const elements = document.querySelectorAll(".reveal");

  const show = (el) => el.classList.add("visible");

  if (typeof IntersectionObserver !== "undefined" && elements.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            show(entry.target);
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -6% 0px" }
    );

    elements.forEach((el) => observer.observe(el));
  } else {
    elements.forEach(show);
  }
</script>